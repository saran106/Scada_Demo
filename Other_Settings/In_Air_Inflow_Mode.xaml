<Window x:Class="Scada_Demo.Other_Settings.In_Air_Inflow_Mode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In Air / In Flow Mode"
        Height="680"
        Width="650"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>

                    <RowDefinition Height="80"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="48"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/Pincode.png"
                               Width="24"
                               Height="24"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="In Air / In Flow Batch Mode"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- HEADER LINE -->

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>

                        <RowDefinition Height="90"/>

                    </Grid.RowDefinitions>

                    <!-- Next Part -->


                    <!-- ================================================= -->
                    <!-- MODULE 1 - CHANNEL 1 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 1 channel 1 batch mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="0"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- MODULE 1 - CHANNEL 2 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 1 channel 2 batch mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
                                  
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="1"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- MODULE 2 - CHANNEL 1 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 2 channel 1 Batch Mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="2"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- MODULE 2 - CHANNEL 2 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="3" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 2 channel 1 batch mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="3"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>
                    
                    




                    <!-- ================================================= -->
                    <!-- MODULE 3 - CHANNEL 1 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 3 channel 1 batch mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="4"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- MODULE 3 - CHANNEL 2 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="5" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 3 channel 2 batch Mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="5"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- MODULE 4 - CHANNEL 1 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="6" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Module 4 channel 1 batch Mode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="6"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="7"
        Margin="-22,8,-22,-30"
        CornerRadius="0,0,18,18"
        BorderBrush="#E5E7EB"
        Background="#F3F4F6"
        ClipToBounds="True">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- READ -->

                            <Button Grid.Column="1"
                Height="46"
                Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/read.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Read from PLC"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- WRITE -->

                            <Button Grid.Column="3"
                Height="46"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Write PLC / DB"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button Grid.Column="5"
                Height="46"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Exit"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>