<Window x:Class="Scada_Demo.Other_Settings.Capacity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capacity"
        Height="520"
        Width="650"
        Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid Grid.Row="0"
                      Margin="0,-35,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/Quantity.png"
                               Width="24"
                               Height="24"/>

                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Weigher / Hopper Capacity"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,18">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- BODY -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>

                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= AGGREGATE ================= -->

                        <Border Grid.Row="0"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Product_Name.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="0"
           Grid.Column="1"
           Text="Aggregate Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="0"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="1"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= CEMENT ================= -->

                        <Border Grid.Row="2"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Product_Name.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="2"
           Grid.Column="1"
           Text="Cement Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="2"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="3"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>


                        <!-- ================= WATER ================= -->

                        <Border Grid.Row="4"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Address.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="4"
           Grid.Column="1"
           Text="Water Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="4"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="5"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= WATER 2 / ICE ================= -->

                        <Border Grid.Row="6"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/calendar.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="6"
           Grid.Column="1"
           Text="Water 2 / Ice Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="6"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="7"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= ADMIXTURE 1 & 2 ================= -->

                        <Border Grid.Row="8"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="8"
           Grid.Column="1"
           Text="Admixture 1 &amp; 2 Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="8"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="9"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= ADMIXTURE 3 & 4 ================= -->

                        <Border Grid.Row="10"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="10"
           Grid.Column="1"
           Text="Admixture 3 &amp; 4 Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="10"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="11"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= SILICA ================= -->

                        <Border Grid.Row="12"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Product_Name.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="12"
           Grid.Column="1"
           Text="Silica Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="12"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="13"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= CRYSTALLINE ================= -->

                        <Border Grid.Row="14"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Product_Name.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="14"
           Grid.Column="1"
           Text="Crystalline Capacity (Kg)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="14"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="15"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= SILO 1 ================= -->

                        <Border Grid.Row="16"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Quantity.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="16"
           Grid.Column="1"
           Text="Silo 1 Capacity (Tons)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="16"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="17"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= SILO 2 ================= -->

                        <Border Grid.Row="18"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Quantity.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="18"
           Grid.Column="1"
           Text="Silo 2 Capacity (Tons)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="18"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="19"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>



                        <!-- ================= SILO 3 ================= -->

                        <Border Grid.Row="20"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Quantity.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="20"
           Grid.Column="1"
           Text="Silo 3 Capacity (Tons)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="20"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="21"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= SILO 4 ================= -->

                        <Border Grid.Row="22"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Quantity.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="22"
           Grid.Column="1"
           Text="Silo 4 Capacity (Tons)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="22"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                        <Border Grid.Row="23"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>

                        <!-- ================= SILO 5 ================= -->

                        <Border Grid.Row="24"
        Width="40"
        Height="40"
        Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Quantity.png"
           Width="22"
           Height="22"/>

                        </Border>

                        <TextBlock Grid.Row="24"
           Grid.Column="1"
           Text="Silo 5 Capacity (Tons)"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="24"
         Grid.Column="3"
         Height="36"
         Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                </ScrollViewer>

                <!-- ================= PREMIUM FOOTER ================= -->

                <Border Grid.Row="2"
        Margin="-22,8,-22,-22"
        Background="#F3F4F6"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

                    <Grid Margin="12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="15"/>

                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="15"/>

                            <ColumnDefinition Width="120"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- READ -->

                        <Button Grid.Column="1"
                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <Image Source="/Icons/Quantity.png"
                       Width="20"
                       Height="20"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="Read PLC"
                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>

                        <!-- WRITE -->

                        <Button Grid.Column="3"
                Style="{StaticResource SaveButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <Image Source="/Icons/save.png"
                       Width="20"
                       Height="20"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="Write PLC / DB"
                           Foreground="White"
                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>

                        <!-- EXIT -->

                        <Button Grid.Column="5"
                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <Image Source="/Icons/exit.png"
                       Width="20"
                       Height="20"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="Exit"
                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>