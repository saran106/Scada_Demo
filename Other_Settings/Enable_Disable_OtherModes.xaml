                        </Grid>

                        <Border Grid.Row="7"
                                Background="#ECEFF3"/>

                        <!-- ================= Aggregate Weigher type ================= -->

                        <Grid Grid.Row="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
