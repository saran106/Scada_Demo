                Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="NoofCopies"
Grid.Column="3"
Height="36"
  IsEditable="True"
Style="{DynamicResource SiteComboBoxStyle}"/>
                        </Grid>

                        <Border Grid.Row="25"
         Background="#ECEFF3"/>

                    </Grid>

                    <!-- ================= RIGHT COLUMN ================= -->

                    <Grid Grid.Column="2">

