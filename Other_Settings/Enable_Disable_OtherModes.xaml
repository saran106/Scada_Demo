                Text="Voice Alarm"
                Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="VoiceA"
Grid.Column="3"
Height="36"
  IsEditable="True"
Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="23"
         Background="#ECEFF3"/>


                        <!-- ================= No.OF COPIES OF PRINT ALARM ================= -->

