                        </Grid>

                        <Border Grid.Row="15"
                                Background="#ECEFF3"/>



                        <!-- ================= Generic Interfacing ID ================= -->

                        <Grid Grid.Row="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
