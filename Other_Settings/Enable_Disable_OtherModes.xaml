                                      Height="36"
                                        IsEditable="True"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="9"
                                Background="#ECEFF3"/>


                        <!-- ================= Aggregate traverse mode ================= -->

                        <Grid Grid.Row="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border  Width="36"
                                    Height="36"
                                    Style="{DynamicResource SiteIconBoxStyle}">

                                <Image Source="/Icons/Distance.png"
