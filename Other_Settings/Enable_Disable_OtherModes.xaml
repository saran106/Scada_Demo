                            <ComboBox x:Name="smscmbTruck"
           Grid.Column="3"
           Height="36"
             IsEditable="True"
           Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="13"
                                Background="#ECEFF3"/>

                        <!-- ================= SMS alaram ================= -->

                        <Grid Grid.Row="14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border  Width="36"
                                    Height="36"
                                    Style="{DynamicResource SiteIconBoxStyle}">

                                <Image Source="/Icons/Quantity.png"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"/>

                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
