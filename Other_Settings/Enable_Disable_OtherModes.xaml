                                       Stretch="Uniform"/>

                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="SMS Weighbridge details"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="smsWeigh"
Grid.Column="3"
Height="36"
  IsEditable="True"
Style="{DynamicResource SiteComboBoxStyle}"/>
                        </Grid>

                        <Border Grid.Row="19"
                                Background="#ECEFF3"/>


                        <!-- ================= Bridge Weight in Report================= -->

                        <Grid Grid.Row="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border  Width="36"
