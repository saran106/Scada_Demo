                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="GI"
Grid.Column="3"
Height="36"
  IsEditable="True"
Style="{DynamicResource SiteComboBoxStyle}"/>
                        </Grid>

                        <Border Grid.Row="17"
