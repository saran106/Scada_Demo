<Window x:Class="Scada_Demo.Other_Settings.Auto_BackupSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Backup Settings"
        Height="520"
        Width="420"
        Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="70"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="78"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-28,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="48"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/calendar.png"
                               Width="22"
                               Height="22"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Auto Backup Settings"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- LINE -->

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,18">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= BODY ================= -->

                <Border Grid.Row="1"
                        Margin="0,5,0,0"
                        Padding="18"
                        CornerRadius="14"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Background="White">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>

                        </Grid.RowDefinitions>

                        <!-- ================================================= -->
                        <!-- DAILY -->
                        <!-- ================================================= -->

                        <Border Grid.Row="0"
            CornerRadius="10"
            BorderBrush="#E7EBEF"
            BorderThickness="1"
            Background="White">

                            <Grid Margin="12,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Calendar.png"
                       Width="18"
                       Height="18"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Daily"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                <RadioButton Grid.Column="2"
                         GroupName="Backup"
                         VerticalAlignment="Center"
                         IsChecked="True"/>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- WEEKLY -->
                        <!-- ================================================= -->

                        <Border Grid.Row="1"
            Margin="0,8,0,0"
            CornerRadius="10"
            BorderBrush="#E7EBEF"
            BorderThickness="1"
            Background="White">

                            <Grid Margin="12,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Calendar.png"
                       Width="18"
                       Height="18"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Weekly"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                <RadioButton Grid.Column="2"
                         GroupName="Backup"
                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- FORTNIGHTLY -->
                        <!-- ================================================= -->

                        <Border Grid.Row="2"
            Margin="0,8,0,0"
            CornerRadius="10"
            BorderBrush="#E7EBEF"
            BorderThickness="1"
            Background="White">

                            <Grid Margin="12,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Calendar.png"
                       Width="18"
                       Height="18"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Fortnightly"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                <RadioButton Grid.Column="2"
                         GroupName="Backup"
                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- MONTHLY -->
                        <!-- ================================================= -->

                        <Border Grid.Row="3"
            Margin="0,8,0,0"
            CornerRadius="10"
            BorderBrush="#E7EBEF"
            BorderThickness="1"
            Background="White">

                            <Grid Margin="12,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Calendar.png"
                       Width="18"
                       Height="18"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Monthly"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                <RadioButton Grid.Column="2"
                         GroupName="Backup"
                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </Grid>
                    
                    

                </Border>


                <!-- ================= FOOTER ================= -->

                <Border Grid.Row="2"
        Margin="-20,8,-20,-20"
        Background="#F3F4F6"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

                    <Grid Margin="12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ================= SAVE ================= -->

                        <Button Grid.Column="1"
                Height="42"
                                Width="130"
                Style="{StaticResource SaveButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <Image Source="/Icons/save.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="Save"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                            </StackPanel>

                        </Button>

                        <!-- ================= EXIT ================= -->

                        <Button Grid.Column="3"
                Height="42"
                  Width="130"
                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <Image Source="/Icons/exit.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                                <TextBlock Text="Exit"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>
                
                
                