<Window x:Class="Scada_Demo.Other_Settings.Plant_Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant Profile"
        Height="770"
        Width="620"
        Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">


    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>

                    <RowDefinition Height="80"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="48"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/mixer-truck.png"
                               Width="26"
                               Height="26"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Plant Profile"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- ACCENT LINE -->

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                         <RowDefinition Height="54"/>

                        <RowDefinition Height="70"/>

                        <RowDefinition Height="90"/>

                    </Grid.RowDefinitions>

                    <!-- ================================================= -->

                    <!-- TRUCK REG NO STARTS HERE -->

                    <!-- ================================================= -->

                    <!-- ================= TRUCK REG NO ================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Plant serial number"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                  

                        <TextBox x:Name="cmbTruckNo"
           Grid.Column="3"
           Height="42"
           VerticalAlignment="Center"
           Style="{DynamicResource SiteTextBoxStyle}"/>


                    </Grid>

                    <!-- DIVIDER -->

                    <Border Grid.Row="0"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================= DRIVER ================= -->

                    <Grid Grid.Row="1" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Plant model / type"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtDriver"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <!-- DIVIDER -->

                    <Border Grid.Row="1"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================= CAPACITY ================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Distance.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Other plant capacity"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtCapacity"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>


                    <!-- DIVIDER -->

                    <Border Grid.Row="2"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================= TYPE OF TRUCK ================= -->

                    <Grid Grid.Row="3" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Site.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Company name"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtTruckType"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <!-- DIVIDER -->

                    <Border Grid.Row="3"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================= MIXER GATE TIMER ================= -->

                    <Grid Grid.Row="4" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <!-- Timer icon illa na blue icon box mattum -->
                            <Image Source="/Icons/Distance1.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Plant code / Asset code"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtMixerGateTimer"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>


                    <Border Grid.Row="4"
             Margin="0,50,0,0"
             Height="1"
             Background="#ECEFF3"/>



                    <Grid Grid.Row="5" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                   Height="40"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Style="{DynamicResource SiteIconBoxStyle}">

                            <!-- Timer icon illa na blue icon box mattum -->
                            <Image Source="/Icons/Distance1.png"
                      Width="22"
                      Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="Auto header"
                      Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtAutoheader"
                    Grid.Column="3"
                    Height="42"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>


                    <Border Grid.Row="5"
 Margin="0,50,0,0"
Height="1"
Background="#ECEFF3"/>





                    <Grid Grid.Row="6" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                   Height="40"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Style="{DynamicResource SiteIconBoxStyle}">

                            <!-- Timer icon illa na blue icon box mattum -->
                            <Image Source="/Icons/Distance1.png"
                      Width="22"
                      Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="TCP/IP port number"
                      Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="TCPnumber"
                    Grid.Column="3"
                    Height="42"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>


                    <Border Grid.Row="6"
 Margin="0,50,0,0"
Height="1"
Background="#ECEFF3"/>



                    

                    <Grid Grid.Row="7" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                   Height="40"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Style="{DynamicResource SiteIconBoxStyle}">

                            <!-- Timer icon illa na blue icon box mattum -->
                            <Image Source="/Icons/Distance1.png"
                      Width="22"
                      Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="Batch No / Ticket No"
                      Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="Batchnumber"
                    Grid.Column="3"
                    Height="42"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>


                    <Border Grid.Row="7"
 Margin="0,50,0,0"
Height="1"
Background="#ECEFF3"/>


                    <!-- ================================================= -->
                    <!-- CUSTOM LOGO LOCATION -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="8" Height="60">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Phone.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <!-- Label -->

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Custom Logo"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- Path -->

                        <TextBox Grid.Column="3"
             Height="42"
             Margin="0,0,8,0"
             Text="NA"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                        <!-- Upload -->

                        <Button Grid.Column="4"
            Width="90"
            Height="42"
            Style="{StaticResource WhiteActionButtonStyle}"
            Content="Upload"/>

                    </Grid>

                    <Border Grid.Row="8"
         Margin="0,50,0,0"
        Height="1"
        Background="#ECEFF3"/>
                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="9"
        Margin="-22,5,-22,-25"
        CornerRadius="0,0,18,18"
        BorderBrush="#E5E7EB"
        Background="#F3F4F6"
        ClipToBounds="True">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- SAVE -->

                            <Button Grid.Column="1"
                Height="46"
               
                Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Save"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- DELETE -->

                            <Button Grid.Column="3"
                Height="46"
                
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/Delete.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Delete"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button Grid.Column="5"
                Height="46"
                
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Exit"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
                
                