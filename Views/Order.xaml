                        <TextBlock Text="Max Cement used" Grid.Row="8" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Cement water ratio" Grid.Row="9" Style="{StaticResource LabelStyle}"/>

                        --><!-- INPUTS --><!--
                        <TextBox Grid.Row="0" Grid.Column="1" Text="NA"
