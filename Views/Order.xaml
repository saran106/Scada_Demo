<Window x:Class="Scada_Demo.Views.Order"
        Title="Order Master"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
         xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Height="765"
        Width="1150"
        Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="../project_small_i.png">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.12"
                                  Color="Black"/>
            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="95"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-35,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Grid.Column="0"
                  Width="42"
                  Height="36"
                  Style="{DynamicResource SiteIconBoxStyle}">

                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>

                                        <svgc:SvgViewbox Source="/Icons/Order.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>

                    </Border>


                    <!-- TITLE -->

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Order Master"
                                   Style="{DynamicResource SiteHeaderStyle}"/>

                      
                    

                    </StackPanel>

                    <!-- HEADER LINE -->

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,18">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= BODY ================= -->

                <Grid Grid.Row="1"
                      
                      Margin="0,8,0,-20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="40"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->

                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <!-- ================= ORDER ID ================= -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/ID.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Order ID"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbOrderId"
                                      Grid.Column="3"
                                      Height="36"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="1"
                                Background="#ECEFF3"/>

                        <!-- ================= ORDER DATE ================= -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Calender.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Order Date"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <DatePicker Grid.Column="3"
                                        Height="36"
                                        FontSize="15"
                                        VerticalContentAlignment="Center"/>

                        </Grid>

                        <Border Grid.Row="3"
                                Background="#ECEFF3"/>

                        <!-- ================= CUSTOMER ================= -->

                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Customer.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Customer ID"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbCustomer"
                                      Grid.Column="3"
                                      IsEditable="True"
                                      Height="36"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="5"
                                Background="#ECEFF3"/>

                        <!-- ================= RECIPE ================= -->

                        <Grid Grid.Row="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Recipe.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Recipe ID"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbRecipe"
                                      Grid.Column="3"
                                        IsEditable="True"
                                      Height="36"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="7"
                                Background="#ECEFF3"/>

                        <!-- ================= SITE ================= -->

                        <Grid Grid.Row="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Site.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Site"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbSite"
                                      Grid.Column="3"
                                      Height="36"
                                        IsEditable="True"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="9"
                                Background="#ECEFF3"/>


                        <!-- ================= TRUCK ================= -->

                        <Grid Grid.Row="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Concrete_truck.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Truck ID"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbTruck"
                                      Grid.Column="3"
                                      Height="36"
                                        IsEditable="True"
                                      Style="{DynamicResource SiteComboBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="11"
                                Background="#ECEFF3"/>

                        <!-- ================= ORDERED QTY ================= -->

                        <Grid Grid.Row="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Quantity.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Ordered Qty (M³)"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Grid.Column="3"
                                     Height="36"
                                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="13"
                                Background="#ECEFF3"/>

                        <!-- ================= PRODUCTION QTY ================= -->

                        <Grid Grid.Row="14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Quantity.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Production Qty (M³)"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Grid.Column="3"
                                     Height="36"
                                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="15"
                                Background="#ECEFF3"/>



                        <!-- ================= ADJUST QTY ================= -->

                        <Grid Grid.Row="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Quantity.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Adjust Qty (M³)"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Grid.Column="3"
                                     Text="0"
                                     Height="36"
                                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="17"
                                Background="#ECEFF3"/>

                        <!-- ================= LOAD SENT ================= -->

                        <Grid Grid.Row="18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
                                    Height="40"
                                    Style="{DynamicResource SiteIconBoxStyle}">

                                <Image Source="/Icons/Quantity.png"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"/>

                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Load Sent (M³)"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Grid.Column="3"
                                     Height="36"
                                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="19"
                                Background="#ECEFF3"/>

                    </Grid>

                    <!-- ================= RIGHT COLUMN ================= -->

                    <Grid Grid.Column="2">

                        <Grid.RowDefinitions>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>


                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                         <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <!-- ================= AGGREGATE USED ================= -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Aggregate Used"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Grid.Column="3"
                                     Text="NA"
                                     Height="36"
                                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </Grid>

                        <Border Grid.Row="1"
