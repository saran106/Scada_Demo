<Window x:Class="Scada_Demo.Views.Site_Details"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Icon="../project_small_i.png"
        Title="Site_Details"
        Height="700"
        Width="500"

        WindowStartupLocation="CenterScreen"

        ResizeMode="NoResize"

        Background="{StaticResource PrimaryBgBrush}">
    <Grid>
        <Grid  Margin="10">

            <!-- STYLES -->
            <Grid.Resources>

            

                <!-- Input -->
                <Style x:Key="InputStyle" TargetType="TextBox">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="0,5"/>
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00FFFF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Style>

                <!-- Combo -->
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="0,5"/>
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00FFFF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Style>

                <!-- Button -->
                <Style x:Key="BtnStyle" TargetType="Button">
                    <Setter Property="Width" Value="120"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#0B1F1F"/>
                    <Setter Property="Foreground" Value="#00FFFF"/>
                    <Setter Property="BorderBrush" Value="#00FFFF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Margin" Value="10"/>
                </Style>

            </Grid.Resources>



            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Text="Site Details"
                        Style="{DynamicResource HeaderTextStyle}"
                       Margin="5"/>

            <!-- CARD -->
            <Border  Grid.Row="1"
   Margin="10"
   Padding="20"
   Background="{StaticResource PanelBrush}"
   BorderBrush="{StaticResource BorderBrushColor}"
   BorderThickness="2"
   CornerRadius="6">

                <Grid>

                    <!-- FORM -->
                    <Grid Grid.Row="1" Margin="5">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- LABELS -->
                        <TextBlock Text="Customer ID" Grid.Row="0" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Site" Grid.Row="1" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Address" Grid.Row="2" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="3"/>
                        <TextBlock Grid.Row="4"/>
                        <TextBlock Text="City" Grid.Row="5" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Pincode" Grid.Row="6" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Phone" Grid.Row="7" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Contact" Grid.Row="8" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Distance" Grid.Row="9" Style="{StaticResource LabelStyle}"/>

                        <!-- INPUTS -->
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbCustomerID"  SelectionChanged="cmbCustomerID_SelectionChanged"  Style="{StaticResource CompactComboBoxSmall}"/>
                        <ComboBox x:Name="cmbSiteID"
          Grid.Row="1"
          Grid.Column="1"
          IsEditable="True"
          IsTextSearchEnabled="False"
          SelectionChanged="cmbSiteID_SelectionChanged"
          Style="{StaticResource CompactComboBoxSmall}"/>

                        <TextBox x:Name="txtAddress1"
         Grid.Row="2"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtAddress2"
         Grid.Row="3"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtAddress3"
         Grid.Row="4"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtCity"
         Grid.Row="5"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtPincode"
         Grid.Row="6"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtPhone"
         Grid.Row="7"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtContact"
         Grid.Row="8"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>

                        <TextBox x:Name="txtDistance"
         Grid.Row="9"
         Grid.Column="1"
         Style="{StaticResource JogTextBoxStyle}"
         Height="34"/>
                    </Grid>

             

                </Grid>
            </Border>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Center"
                 Margin="0,15">


                <Button Content="SAVE"
        Width="105"
        Click="btnSave_Click"/>

                <Button Content="DELETE"
        Width="105"
        Click="btnDelete_Click"/>

                <Button Content="EXIT"
        Width="105"
        Style="{StaticResource RedButton}"
        Click="btnExit_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
