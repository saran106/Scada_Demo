<Window x:Class="Scada_Demo.Views.Inward"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Material Inward"
        Width="650"
        Height="500"
              xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SitePageBackgroundBrush}">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>

                    <RowDefinition Height="90"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-60,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="50"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- HEADER ICON -->

                    <Border Grid.Column="0"
                            Style="{DynamicResource SiteHeaderIconStyle}">

                        <Image Source="/Icons/Inward.png"
                               Width="28"
                               Height="28"
                               Stretch="Uniform"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{DynamicResource SiteHeaderStyle}"
                               Text="Material Inward"/>

                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,35">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="11"
                                 Height="11"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"
                                 Margin="0,-1,0,0"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-20,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- ================= PRODUCT ================= -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="170"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Product.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Product Name"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- KEEP YOUR x:Name -->

                        <ComboBox Grid.Column="3"
                                  Height="34"
                                  IsEditable="True"
                                  Width="300"
                                  HorizontalAlignment="Left"
                                  Style="{DynamicResource SiteComboBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Background="#ECEFF3"
                            Height="0.8"/>

                    <!-- ================= INWARD DATE ================= -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="170"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Calender.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="Inward Date"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- KEEP YOUR x:Name -->

                        <DatePicker Grid.Column="3"
                                    Width="300"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    FontSize="15"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Background="#ECEFF3"
                            Height="0.8"/>

                    <!-- ================= QUANTITY ================= -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="170"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Quantity.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="Quantity"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- KEEP YOUR x:Name -->

                        <TextBox Grid.Column="3"
                                 Width="300"
                                 Height="34"
                                 HorizontalAlignment="Left"
                                 Text="0"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="5"
                            Background="#ECEFF3"
                            Height="0.8"/>

                    <!-- ================= UOM ================= -->

                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="170"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Types.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="UOM"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- KEEP YOUR x:Name -->

                        <ComboBox Grid.Column="3"
                                  IsEditable="True"
                                  Width="300"
                                  Height="34"
                                  HorizontalAlignment="Left"
                                  Style="{DynamicResource SiteComboBoxStyle}">

                            <ComboBoxItem Content="Kg"/>
                            <ComboBoxItem Content="Ton"/>
                            <ComboBoxItem Content="Litre"/>

                        </ComboBox>

                    </Grid>

                    <Border Grid.Row="7"
                            Background="#ECEFF3"
                            Height="0.8"/>

                    <!-- ================= BOTTOM ACTION PANEL ================= -->
                    <!-- ================= BOTTOM ACTION PANEL ================= -->

                    <Border Grid.Row="8"
        Margin="-25,20,-25,-25"
        Height="95"
        VerticalAlignment="Top"
        Background="#F3F4F6"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

                        <Grid Margin="15">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="155"/>

                                <ColumnDefinition Width="15"/>

                                <ColumnDefinition Width="155"/>

                                <ColumnDefinition Width="15"/>

                                <ColumnDefinition Width="155"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- ================= SAVE ================= -->

                            <Button Grid.Column="1"
                Height="42"
                Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Save"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <!-- ================= DELETE ================= -->

                            <Button Grid.Column="3"
                Height="42"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/Delete.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Delete"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <!-- ================= EXIT ================= -->

                            <Button Grid.Column="5"
                Height="42"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"/>

                                    <TextBlock Text="Exit"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>