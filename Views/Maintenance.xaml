<Window x:Class="Scada_Demo.Views.Maintenance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Views"
        mc:Ignorable="d"
        Title="Maintenance"
        Width="720"
        Height="570"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        ResizeMode="NoResize"
        Background="{DynamicResource SitePageBackgroundBrush}">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>

                    <RowDefinition Height="80"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="48"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>

                                        <svgc:SvgViewbox Source="/Icons/Maintenance.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>


                    </Border>


                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Maintenance Configuration"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>

                        <!-- Footer -->

                        <RowDefinition Height="90"/>

                    </Grid.RowDefinitions>

                    <!-- ================================================= -->

                    <!-- MAINTENANCE ID STARTS HERE -->

                    <!-- ================================================= -->

                    <!-- ================= MAINTENANCE ID ================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/ID.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>


                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Maintenance ID"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox x:Name="cmbMaintID"
              Grid.Column="3"
              Height="42"
              VerticalAlignment="Center"
              IsEditable="True"
              IsTextSearchEnabled="False"
              SelectionChanged="cmbMaintID_SelectionChanged"
              Style="{DynamicResource SiteComboBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="0"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================= MESSAGE DESCRIPTION ================= -->

                    <Grid Grid.Row="1" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Message.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>


                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Message Description"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtMaintDesc"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================= DAYWISE TRIGGER ================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Calender.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>


                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Daywise Trigger (Days)"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtDaywise"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="2"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================= MIXER RUNNING WISE ================= -->

                    <Grid Grid.Row="3" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Timer.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>


                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Mixer Running (Hrs)"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtMixerwise"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="3"
        Margin="0,57,0,0"
        Height="1"
        Background="#ECEFF3"/>

                    <!-- ================= PRODUCTION WISE ================= -->

                    <Grid Grid.Row="4" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Production.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>


                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Production Wise (M³)"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtProdwise"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <!-- ================= FOOTER ================= -->

                    <!-- ================= FOOTER ================= -->

                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="5"
      Margin="-22,8,-22,-120"
        Height="110"
        VerticalAlignment="Top"
        Background="#F7F8FA"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

                        <UniformGrid Columns="4" Margin="12,8">

                            <!-- EXPORT -->

                            <Button Height="36"
                Margin="4,0"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                       Width="14"
                       Height="14"
                       Margin="0,0,5,0"/>

                                    <TextBlock Text="Export"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                </StackPanel>

                            </Button>

                            <!-- IMPORT -->

                            <Button Height="36"
                Margin="4,0"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/Customer_ID2.png"
                       Width="14"
                       Height="14"
                       Margin="0,0,5,0"/>

                                    <TextBlock Text="Import"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                </StackPanel>

                            </Button>

                            <!-- SAVE -->

                            <Button Height="36"
                Margin="4,0"
                Click="btnSave_Click"
                Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                       Width="14"
                       Height="14"
                       Margin="0,0,5,0"/>

                                    <TextBlock Text="Save"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button Height="36"
                Margin="4,0"
                Click="btnExit_Click"
                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                       Width="14"
                       Height="14"
                       Margin="0,0,5,0"/>

                                    <TextBlock Text="Exit"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                </StackPanel>

                            </Button>

                        </UniformGrid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>