<Window x:Class="Scada_Demo.Views.Maintenance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Views"
        mc:Ignorable="d"
        Title="Maintenance"         Height="450" Width="620"
Background="#0D3A3A" 
  
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">

        <!-- MAIN ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <TextBlock Text="Maintenance Configuration"
                   Margin="10,5"
                   Style="{StaticResource HeaderTextStyle}"/>

        <!-- ================= CONTENT ================= -->
        <Border Grid.Row="1"
                Margin="10"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <!-- Label -->
                    <ColumnDefinition Width="20"/>
                    <!-- Gap -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Input -->
                </Grid.ColumnDefinitions>

                <!-- 🔥 CHANGE HERE -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1 -->
                <TextBlock Text="Maintenance ID"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>
                <ComboBox
    x:Name="cmbMaintID"
    IsEditable="True"
    IsTextSearchEnabled="False"
    SelectionChanged="cmbMaintID_SelectionChanged"
    Grid.Row="0"
    Grid.Column="2"
    Width="180"
    Height="34"
    Style="{StaticResource CompactComboBoxSmall}"/>


                <!-- 2 -->
                <TextBlock Text="Message Description"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox
    x:Name="txtMaintDesc"
    Grid.Row="2"
    Grid.Column="2"
    Width="180"
    Height="34"
    Margin="6,6,14,6"
    Style="{StaticResource JogTextBoxStyle}"/>

                <!-- 3 -->
                <TextBlock Text="Daywise trigger(no of days)"
                           Grid.Row="3"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox
    x:Name="txtDaywise"
    Grid.Row="3"
    Grid.Column="2"
    Width="180"
    Height="34"
    Margin="6,6,14,6"
    Style="{StaticResource JogTextBoxStyle}"/>

                <!-- 4 -->
                <TextBlock Text="Mixer running wise trigger(hrs)"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>


                <TextBox
    x:Name="txtMixerwise"
    Grid.Row="4"
    Grid.Column="2"
    Width="180"
    Height="34"
    Margin="6,6,14,6"
    Style="{StaticResource JogTextBoxStyle}"/>

                <!-- 5 -->
                <TextBlock Text="Production wise trigger(M)"
                           Grid.Row="5"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox
    x:Name="txtProdwise"
    Grid.Row="5"
    Grid.Column="2"
    Width="180"
    Height="34"
    Margin="6,6,14,6"
    Style="{StaticResource JogTextBoxStyle}"/>



            </Grid>
        </Border>

        <!-- ================= BUTTONS ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="Export"
                    Width="100"
                   />

            <Button Content="Import"
                    Width="100"
                    Margin="8"/>

            <Button Content="Save"
        Width="100"
        Margin="8"
        Click="btnSave_Click"/>

            <Button Content="Exit"
        Width="100"
        Margin="8"
        Style="{StaticResource RedButton}"
        Click="btnExit_Click"/>

        </StackPanel>

    </Grid>
</Window>
