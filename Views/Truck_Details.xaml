<Window x:Class="Scada_Demo.Views.Truck_Details"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truck Details"
        Height="450"
        Width="620"
        Background="#0D3A3A"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="../project_small_i.png">

    <Grid Margin="8">

        <!-- MAIN ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Truck Details"
                   Margin="10,5"
                   Style="{StaticResource HeaderTextStyle}"/>

        <!-- CONTENT -->
        <Border Grid.Row="1"
                Margin="10"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Truck Reg No -->
                <TextBlock Text="Truck Reg No"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <ComboBox Grid.Row="0"
                          Grid.Column="2"
                          Width="180"
                          Height="34"
                          Style="{StaticResource CompactComboBoxSmall}"/>

                <!-- Driver -->
                <TextBlock Text="Driver"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="1"
                         Grid.Column="2"
                         Width="180"
                         Height="34"
                         Margin="6,6,14,6"
                         Style="{StaticResource JogTextBoxStyle}"/>

                <!-- Capacity -->
                <TextBlock Text="Capacity"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="2"
                         Grid.Column="2"
                         Width="180"
                         Height="34"
                         Margin="6,6,14,6"
                         Style="{StaticResource JogTextBoxStyle}"/>

                <!-- Type of Truck -->
                <TextBlock Text="Type of Truck"
                           Grid.Row="3"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="3"
                         Grid.Column="2"
                         Width="180"
                         Height="34"
                         Margin="6,6,14,6"
                         Style="{StaticResource JogTextBoxStyle}"/>

                <!-- Mixer Gate Timer -->
                <TextBlock Text="Mixer Gate Timer"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="4"
                         Grid.Column="2"
                         Width="180"
                         Height="34"
                         Margin="6,6,14,6"
                         Style="{StaticResource JogTextBoxStyle}"/>

            </Grid>

        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="Save"
                    Width="100"
                    Margin="8"/>

            <Button Content="Delete"
                    Width="100"
                    Margin="8"/>

            <Button Content="Exit"
                    Width="100"
                    Margin="8"
                    Style="{StaticResource RedButton}"/>

        </StackPanel>

    </Grid>

</Window>