<Window x:Class="Scada_Demo.Views.Customer_Master"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 Icon="../project_small_i.png"
       
        Title="Customer Master"
        Height="640" Width="500"

        Background="{StaticResource PrimaryBgBrush}"

        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">


          

                <!-- LAYOUT -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <TextBlock Text="Customer Master"
                           Margin="10,5"
                             Style="{DynamicResource 
                    HeaderTextStyle}"
                         />

                <Border  Grid.Row="1"
                Margin="10"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <!-- FORM -->
                <Grid >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ROWS -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LABELS -->
                    <TextBlock Text="Customer ID" Grid.Row="0" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Name" Grid.Row="1" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Address" Grid.Row="2" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="City" Grid.Row="3" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Pincode" Grid.Row="4" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Phone" Grid.Row="5" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Contact" Grid.Row="6" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Reg. No." Grid.Row="7" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="VAT/GST No." Grid.Row="8" Style="{StaticResource LabelStyle}"/>

                    <!-- INPUTS -->

                <ComboBox x:Name="cmbCustomerID"
          Grid.Row="0"
          Grid.Column="1"
                           SelectionChanged="cmbCustomerID_SelectionChanged"
            Style="{StaticResource CompactComboBoxSmall}"/>

                <TextBox x:Name="txtCustomerName" Grid.Row="1" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtAddress" Grid.Row="2" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtCity" Grid.Row="3" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtPincode" Grid.Row="4" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtPhone" Grid.Row="5" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtContact" Grid.Row="6" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtRegNo" Grid.Row="7" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

                <TextBox x:Name="txtGST" Grid.Row="8" Grid.Column="1" Style="{StaticResource JogTextBoxStyle}" Height="34"/>

            </Grid>
        </Border>

        <!-- BUTTONS -->
                <!-- BUTTONS -->
                <StackPanel Grid.Row="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Center"
                 Margin="0,15">

            <Button x:Name="btnSave"
        Content="SAVE"
        Width="90"
        Click="btnSave_Click"/>

            <Button x:Name="btnDelete"
        Content="DELETE"
        Width="90"
        Click="btnDelete_Click"/>

            <Button x:Name="btnExit"
        Content="EXIT"
        Width="90"
        Style="{StaticResource RedButton}"
        Click="btnExit_Click"/>

        </StackPanel>

        
       
    </Grid>
</Window>