<Window x:Class="Scada_Demo.Views.Customer_Master"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Icon="../project_small_i.png"
        Title="Customer Master"
        Width="900"
        Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SitePageBackgroundBrush}">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-60,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/Customer_ID2.png"
                               Width="28"
                               Height="28"/>

                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Customer Master"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,35">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="11"
                                 Height="11"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-20,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="90"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- ================= CUSTOMER ID ================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
               Width="22"
               Height="22"/>
                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Customer ID"
               Style="{DynamicResource SiteLabelStyle}"/>

                    


                        <ComboBox 
                          Grid.Column="3"
                x:Name="cmbCustomerID"
                Height="42"
                          Tag="Enter City"
                VerticalAlignment="Center"
                 IsEditable="True"
IsTextSearchEnabled="False"
Style="{DynamicResource SiteComboBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- ================= CUSTOMER NAME ================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
               Width="22"
               Height="22"/>
                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Customer Name"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtCustomerName"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- ================= ADDRESS ================= -->

                    <Grid Grid.Row="4" Height="86">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Address1.png"
               Width="22"
               Height="22"/>
                        </Border>

                        <TextBlock Grid.Column="1"
               Margin="0,8,0,0"
               Text="Address"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtAddress"
             Grid.Column="3"
             Height="64"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="5"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- ================= CITY ================= -->

                    <Grid Grid.Row="6" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/city.png"
               Width="22"
               Height="22"/>
                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="City"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtCity"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>
                    <Border Grid.Row="7"
                            Background="#ECEFF3"
                            Height="1"/>


                    <!-- ================= PINCODE ================= -->

                    <Grid Grid.Row="8" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Pincode"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtPincode"
             Grid.Column="3"
              Width="180"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="9"
        Background="#ECEFF3"
        Height="1"/>

                    <!-- ================= PHONE + CONTACT ================= -->

                    <Grid Grid.Row="10" Height="58">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>

                            <ColumnDefinition Width="45"/>

                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- PHONE -->

                        <Border Grid.Column="0"
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/phone.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Phone"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtPhone"
             Grid.Column="3"
             Width="180"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                        <!-- CONTACT -->

                        <Border Grid.Column="5"
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="6"
               VerticalAlignment="Center"
               Text="Contact"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtContact"
             Grid.Column="8"
             Width="180"
Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="11"
        Background="#ECEFF3"
        Height="1"/>

                    <!-- ================= REG NO ================= -->

                    <Grid Grid.Row="12" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Reg. No."
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtRegNo"
             Grid.Column="3"
             Height="42"
                                 
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="13"
        Background="#ECEFF3"
        Height="1"/>

                    <!-- ================= GST ================= -->

                    <Grid Grid.Row="14" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
            Height="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
               Width="22"
               Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="VAT / GST No."
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtGST"
             Grid.Column="3"
             Height="42"
             VerticalAlignment="Center"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="15"
        Background="#ECEFF3"
        Height="1"/>

                  

                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="16"
                            Margin="-25,10,-25,-36"
                            Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            CornerRadius="0,0,18,18">

                        <Grid Margin="0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="220"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="220"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="220"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- SAVE -->

                            <Button x:Name="btnSave"
                                    Grid.Column="1"
                                    Click="btnSave_Click"
                                    Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,12,0"/>

                                    <TextBlock Text="Save"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- DELETE -->

                            <Button x:Name="btnDelete"
                                    Grid.Column="3"
                                    Click="btnDelete_Click"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Image Source="/Icons/Delete.png"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,12,0"/>

                                    <TextBlock Text="Delete"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button x:Name="btnExit"
                                    Grid.Column="5"
                                    Click="btnExit_Click"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,12,0"/>

                                    <TextBlock Text="Exit"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>