<Window x:Class="Scada_Demo.Views.Schedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Schedule"
        Width="850"
        Height="740"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SitePageBackgroundBrush}">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="232"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="85"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Rectangle Width="24"
                                   Height="24"
                                   Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>
                                        <svgc:SvgViewbox
                                            Source="/Icons/Calender.svg"
                                            Width="24"
                                            Height="24"
                                            Stretch="Uniform"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>

                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Schedule Configuration"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <!-- SCHEDULE ID -->

                    <Grid Grid.Row="0"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Rectangle Width="24"
                                       Height="24"
                                       Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <svgc:SvgViewbox
                                                Source="/Icons/ID.svg"
                                                Width="24"
                                                Height="24"
                                                Stretch="Uniform"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Schedule ID"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox x:Name="cmbScheduleID"
                                  Grid.Column="3"
                                  Height="42"
                                  VerticalAlignment="Center"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  SelectionChanged="cmbScheduleID_SelectionChanged"
                                  Style="{DynamicResource SiteComboBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- SCHEDULE DATE -->

                    <Grid Grid.Row="2"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Rectangle Width="24"
                                       Height="24"
                                       Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <svgc:SvgViewbox
                                                Source="/Icons/Calender.svg"
                                                Width="24"
                                                Height="24"
                                                Stretch="Uniform"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Schedule Date"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <DatePicker x:Name="dpScheduleDate"
                                    Grid.Column="3"
                                    Height="42"
                                    VerticalAlignment="Center"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- SCHEDULE TYPE -->

                    <Grid Grid.Row="4"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Rectangle Width="24"
                                       Height="24"
                                       Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <svgc:SvgViewbox
                                                Source="/Icons/Production.svg"
                                                Width="24"
                                                Height="24"
                                                Stretch="Uniform"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Schedule Type"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox x:Name="cmbScheduleType"
                                  Grid.Column="3"
                                  Height="42"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource SiteComboBoxStyle}">

                            <ComboBoxItem Content="Continues"/>
                            <ComboBoxItem Content="Alternative"/>
                            <ComboBoxItem Content="No Schedule"/>

                        </ComboBox>

                    </Grid>

                    <Border Grid.Row="5"
                            Background="#ECEFF3"
                            Height="1"/>

                    <!-- SCHEDULE TIME -->

                    <Grid Grid.Row="6"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Rectangle Width="24"
                                       Height="24"
                                       Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <svgc:SvgViewbox
                                                Source="/Icons/Timer.svg"
                                                Width="24"
                                                Height="24"
                                                Stretch="Uniform"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Time (HH:MM)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtTime"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                </Grid>

                <!-- ================= ORDER LIST ================= -->

                <Border Grid.Row="2"
                        Margin="0,5,0,8"
                        Padding="14"
                        Background="#FAFBFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="9">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- AVAILABLE ORDER LIST -->

                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Available Order List"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#263445"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,5"/>

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#DCE2E9"
                                    BorderThickness="1"
                                    CornerRadius="7">

                                <ListBox x:Name="lstAvailableOrders"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6"
                                         FontSize="13"
                                         Foreground="#263445"
                                         SelectionMode="Single"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            </Border>

                        </Grid>

                        <!-- ADD / REMOVE -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <Button Content="&gt;"
                                    Width="44"
                                    Height="42"
                                    Margin="3,7"
                                    FontSize="19"
                                    FontWeight="Bold"
                                    Click="btnAdd_Click"
                                    Style="{StaticResource SaveButtonStyle}"/>

                            <Button Content="&lt;"
                                    Width="44"
                                    Height="42"
                                    Margin="3,7"
                                    FontSize="19"
                                    FontWeight="Bold"
                                    Click="btnRemove_Click"
                                    Style="{StaticResource WhiteActionButtonStyle}"/>

                        </StackPanel>

                        <!-- SELECTED ORDER LIST -->

                        <Grid Grid.Column="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Selected Order List"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#263445"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,5"/>

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#DCE2E9"
                                    BorderThickness="1"
                                    CornerRadius="7">

                                <ListBox x:Name="lstSelectedOrders"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6"
                                         FontSize="13"
                                         Foreground="#263445"
                                         SelectionMode="Single"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>

                <!-- ================= FOOTER ================= -->

                <Border Grid.Row="3"
                        Margin="-22,8,-22,-22"
                        Background="#F7F8FA"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,1,1,0"
                        CornerRadius="0,0,18,18">

                    <UniformGrid Columns="3"
                                 Margin="45,10">

                        <!-- DELETE -->

                        <Button Height="40"
                                Margin="7,0"
                                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Icons/Delete.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Delete"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                            </StackPanel>

                        </Button>

                        <!-- SAVE -->

                        <Button Height="40"
                                Margin="7,0"
                                Click="btnSave_Click"
                                Style="{StaticResource SaveButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Icons/save.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Save"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>

                        </Button>

                        <!-- EXIT -->

                        <Button Height="40"
                                Margin="7,0"
                                Click="btnExit_Click"
                                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Icons/exit.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Exit"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                            </StackPanel>

                        </Button>

                    </UniformGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>

