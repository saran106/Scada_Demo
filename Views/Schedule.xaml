<Window x:Class="Scada_Demo.Views.Schedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule"
        Height="690"
        Width="590"
        Icon="../project_small_i.png"
        Background="{StaticResource PrimaryBgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="8">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Schedule Configuration"
                   Margin="10,5"
                   Style="{StaticResource HeaderTextStyle}"/>

        <!-- ================= FORM ================= -->
        <Border Grid.Row="1"
                Margin="10"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Schedule ID -->
                <TextBlock Text="Schedule ID"
               Grid.Row="0"
               Style="{StaticResource CompactLabel}"
               VerticalAlignment="Center"/>

                <ComboBox x:Name="cmbScheduleID"
              Grid.Row="0"
              Grid.Column="2"
              Width="220"
              Height="34"
              Margin="6"
              SelectionChanged="cmbScheduleID_SelectionChanged"
              Style="{StaticResource CompactComboBoxSmall}"/>

                <!-- Date -->
                <TextBlock Text="Schedule Date"
               Grid.Row="1"
               Style="{StaticResource CompactLabel}"
               VerticalAlignment="Center"/>

                <DatePicker x:Name="dpScheduleDate"
                Grid.Row="1"
                Grid.Column="2"
                Width="220"
                Height="34"
                Margin="7,6,23,6"/>

                <!-- Type -->
                <TextBlock Text="Schedule Type"
               Grid.Row="2"
               Style="{StaticResource CompactLabel}"
               VerticalAlignment="Center"/>

                <ComboBox x:Name="cmbScheduleType"
              Grid.Row="2"
              Grid.Column="2"
              Width="220"
              Height="34"
              Margin="6"
              Style="{StaticResource CompactComboBoxSmall}">

                    <ComboBoxItem Content="Continues"/>
                    <ComboBoxItem Content="Alternative"/>
                    <ComboBoxItem Content="No Schedule"/>

                </ComboBox>

                <!-- Time -->
                <TextBlock Text="Time (HH:MM)"
               Grid.Row="3"
               Style="{StaticResource CompactLabel}"
               VerticalAlignment="Center"/>

                <TextBox x:Name="txtTime"
             Grid.Row="3"
             Grid.Column="2"
             Width="220"
             Height="34"
             Margin="7,6,23,6"
             Style="{StaticResource JogTextBoxStyle}"/>

            </Grid>

        </Border>

        <!-- ================= ORDER LIST ================= -->

        <Border Grid.Row="2"
                Margin="10"
                Padding="15"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Available -->
<StackPanel>

    <TextBlock Text="Available Order List"
               Margin="5"
               Style="{StaticResource CompactLabel}"/>

    <ListBox x:Name="lstAvailableOrders"
             Width="220"
             Height="250"
             Style="{StaticResource DarkListBoxStyle}"
             ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"/>

</StackPanel>

                <!-- Buttons -->

                <StackPanel Grid.Column="1"
            VerticalAlignment="Center">

                    <Button Content="&gt;"
            Width="45"
            Height="40"
            Margin="5"
            Click="btnAdd_Click"/>

                    <Button Content="&lt;"
            Width="45"
            Height="40"
            Margin="5"
            Click="btnRemove_Click"/>

                </StackPanel>

                <!-- Selected -->

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Selected Order List"
                               Margin="5"
                               Style="{StaticResource CompactLabel}"/>

                    <ListBox x:Name="lstSelectedOrders"
                               Width="220"
  Height="250"
  Style="{StaticResource DarkListBoxStyle}"
  ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================= BUTTONS ================= -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">

            <Button Content="DELETE"
                    Width="100"
                    Margin="8"/>

            <Button Content="SAVE"
                    Width="100"
                    Margin="8"  Click="btnSave_Click"/>

            <Button Content="EXIT"
                    Width="100"
                    Margin="8"
                    Style="{StaticResource RedButton}"
                    Click="btnExit_Click"/>

        </StackPanel>

    </Grid>

</Window>