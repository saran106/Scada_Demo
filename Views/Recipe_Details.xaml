<Window x:Class="Scada_Demo.Views.Recipe_Details"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Recipe Master"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="../project_small_i.png"
        Background="{DynamicResource SitePageBackgroundBrush}">

    <Grid>

        <!-- OUTER CARD -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="500"/>

                    <!-- Gap -->
                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
      Grid.ColumnSpan="3"
      Margin="10,0,0,0"
      VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>

                    <!-- Header hi -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
Height="40"
HorizontalAlignment="Center"
VerticalAlignment="Center"
Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Recipe.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>

                        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Text="Recipe Details"
                   Style="{DynamicResource SiteHeaderStyle}"/>

                    </Grid>

                    <!-- Line -->

                    <Grid Grid.Row="1">

                        <Border Height="1"
                VerticalAlignment="Center"
                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                 Height="10"
                 Fill="{DynamicResource SiteAccentBrush}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"/>

                    </Grid>

                </Grid>


                <!-- ================= LEFT PANEL ================= -->

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        Margin="10,5,0,0"
                        BorderThickness="1"
                        CornerRadius="18">

                    <Grid Margin="20">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            <RowDefinition Height="1"/>

                            <RowDefinition Height="48"/>
                            

                        </Grid.RowDefinitions>

                        <!-- ================= RECIPE ID ================= -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
Height="40"
Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>

                                                <svgc:SvgViewbox Source="/Icons/ID.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>

                                </Rectangle>


                            </Border>


                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Recipe ID"
                                       Style="{DynamicResource SiteLabelStyle}"/>

                            <ComboBox x:Name="cmbRecipeId"
                                      Grid.Column="3"
                                      Height="42"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Style="{DynamicResource SiteComboBoxStyle}"
                                      SelectionChanged="cmbRecipeId_SelectionChanged"/>

                        </Grid>

                        <Border Grid.Row="1"
                                Background="#ECEFF3"/>
                        <!-- ================= RECIPE NAME ================= -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>



                            <Border Width="40"
         Height="40"
         Style="{DynamicResource SiteIconBoxStyle}">
                                <Rectangle Width="24"
           Height="24"
           Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Recipe.svg"
                                 Width="24"
                                 Height="24"
