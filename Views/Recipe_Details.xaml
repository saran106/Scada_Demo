                                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Icons/Delete.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"/>

                                <TextBlock Text="Delete"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                            </StackPanel>

                        </Button>

                        <!-- EXIT -->

                        <Button x:Name="btnExit"
                                Grid.Column="5"
                                Click="btnExit_Click"
                                Style="{StaticResource WhiteActionButtonStyle}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Icons/exit.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"/>

                                <TextBlock Text="Exit"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>