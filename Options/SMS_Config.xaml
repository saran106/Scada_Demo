<Window x:Class="Scada_Demo.Options.SMS_Config"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Options"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="SMS Config"
        Height="405"
        Width="625"
        ResizeMode="NoResize"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="25">

                <!-- ================= ROW DEFINITIONS ================= -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-55,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ICON -->

                    <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>

                                        <svgc:SvgViewbox Source="/Icons/Letter.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>


                    </Border>


                    <!-- HEADER TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="SMS Config"
                               Style="{DynamicResource SiteHeaderStyle}"/>


                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,35">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="11"
                                 Height="11"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"
                                 Margin="0,-1,0,0"/>

                    </Grid>

                </Grid>


                <!-- ================= CONTENT ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-20,0,0">

                    <Grid.RowDefinitions>

                        <!-- GSM PORT -->
                        <RowDefinition Height="58"/>

                        <!-- DIVIDER -->
                        <RowDefinition Height="1"/>

                        <!-- SPEED -->
                        <RowDefinition Height="58"/>

                        <!-- FOOTER -->
                        <RowDefinition Height="95"/>

                    </Grid.RowDefinitions>


                    <!-- ================= GSM PORT ================= -->

                    <Grid Grid.Row="0"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- ICON -->

                        <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Sliders.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>



                        <!-- LABEL -->

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Select Port Assigned for GSM"
                                   Style="{DynamicResource SiteLabelStyle}"/>


                        <!-- COMBOBOX -->

                        <ComboBox Grid.Column="3"
                                  Height="42"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource SiteComboBoxStyle}"
                                  IsEditable="True"/>

                    </Grid>


                    <!-- DIVIDER -->

                    <Border Grid.Row="1"
                            Height="1"
                            Background="#ECEFF3"/>


                    <!-- ================= SPEED ================= -->

                    <Grid Grid.Row="2"
                          Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>



                        <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                            <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/Ratio.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>


                        </Border>



                        <!-- LABEL -->

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Speed"
                                   Style="{DynamicResource SiteLabelStyle}"/>


                        <!-- COMBOBOX -->

                        <ComboBox Grid.Column="3"
                                  Height="42"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource SiteComboBoxStyle}"
                                  IsEditable="True"/>

                    </Grid>


                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="3"
                            Margin="-25,10,-25,-36"
                            Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,1,1,0"
                            CornerRadius="0,0,18,18">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- ================= SAVE ================= -->

                            <Button Grid.Column="1"
                                    Height="46"
                                    Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Rectangle Width="18"
                                               Height="18"
                                               Fill="{StaticResource SaveIcon}"
                                               Margin="0,0,8,0">

                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>

                                                    <svgc:SvgViewbox Source="/Icons/save.svg"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Stretch="Uniform"/>

                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>

                                    </Rectangle>

                                    <TextBlock Text="Save"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>

                                </StackPanel>

                            </Button>


                            <!-- ================= EXIT ================= -->

                            <Button Grid.Column="3"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Rectangle Width="18"
                                               Height="18"
                                               Fill="{StaticResource ExitIcon}"
                                               Margin="0,0,8,0">

                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>

                                                    <svgc:SvgViewbox Source="/Icons/exit.svg"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Stretch="Uniform"/>

                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>

                                    </Rectangle>

                                    <TextBlock Text="Exit"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>