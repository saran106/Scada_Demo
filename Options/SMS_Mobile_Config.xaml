<Window x:Class="Scada_Demo.Options.SMS_Mobile_Config"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Options"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="SMS Mobile Config"
        Height="600"
        Width="1200"
        ResizeMode="NoResize"
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-55,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- HEADER ICON -->

                    <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>

                                        <svgc:SvgViewbox Source="/Icons/Letter.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>


                    </Border>



                    <!-- HEADER TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="SMS Mobile Config"
                               Style="{DynamicResource SiteHeaderStyleUser}"/>


                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,35">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="11"
                                 Height="11"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"
                                 Margin="0,-1,0,0"/>

                    </Grid>

                </Grid>


                <!-- ================= CONTENT ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-20,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="95"/>

                    </Grid.RowDefinitions>


                    <!-- ================= TWO PANELS ================= -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="25"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================= LEFT : ALARM ================= -->

                        <Border Grid.Column="0"
                                Style="{DynamicResource SiteOuterBorderStyle}"
                                Padding="20">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="55"/>

                                    <RowDefinition Height="50"/>

                                    <RowDefinition Height="*"/>

                                    <RowDefinition Height="55"/>

                                </Grid.RowDefinitions>


                                <!-- LEFT HEADER -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="45"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Alarm.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>



                                    <TextBlock Grid.Column="1"
                                               Text="Configure Mobile for Alarm"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Style="{DynamicResource SiteHeaderStyleUser}"/>

                                </Grid>


                                <!-- MOBILE INPUT -->

                                <Grid Grid.Row="1">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="45"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBox x:Name="txtAlarmMobile"
                                             Grid.Column="0"
                                             Height="40"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource HeaderTextBoxStyle}"/>


                                    <Button Grid.Column="1"
                                            Width="38"
                                            Height="38"
                                            Margin="7,0,0,0"
                                            Style="{StaticResource SaveButtonStyle}">

                                        <TextBlock Text="+"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Button>

                                </Grid>


                                <!-- MOBILE LIST -->

                                <ListBox x:Name="lstAlarmMobiles"
                                         Grid.Row="2"
                                         Margin="0,10,0,10"
                                         Background="Transparent"
                                         Foreground="#1F2937"
                                         BorderBrush="#E5E7EB"
                                         BorderThickness="1"
                                         Padding="5"/>


                                <!-- REMOVE BUTTON -->

                                <Button Grid.Row="3"
                                        Width="38"
                                        Height="38"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource WhiteActionButtonStyle}">

                                    <TextBlock Text="−"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="#17933A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                            </Grid>

                        </Border>


                        <!-- ================= RIGHT : PRODUCTION ================= -->

                        <Border Grid.Column="2"
                                Style="{DynamicResource SiteOuterBorderStyle}"
                                Padding="20">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="55"/>

                                    <RowDefinition Height="50"/>

                                    <RowDefinition Height="*"/>

                                    <RowDefinition Height="55"/>

                                </Grid.RowDefinitions>


                                <!-- RIGHT HEADER -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="45"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <Border Width="40"
Height="40"
                
Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Product.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>


                                    <TextBlock Grid.Column="1"
                                               Text="Configure Mobile for Production Details"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Style="{DynamicResource SiteHeaderStyleUser}"/>

                                </Grid>


                                <!-- MOBILE INPUT -->

                                <Grid Grid.Row="1">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="45"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBox x:Name="txtProdMobile"
                                             Grid.Column="0"
                                             Height="40"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource HeaderTextBoxStyle}"/>


                                    <Button Grid.Column="1"
                                            Width="38"
                                            Height="38"
                                            Margin="7,0,0,0"
                                            Style="{StaticResource SaveButtonStyle}">

                                        <TextBlock Text="+"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Button>

                                </Grid>


                                <!-- MOBILE LIST -->

                                <ListBox x:Name="lstProdMobiles"
                                         Grid.Row="2"
                                         Margin="0,10,0,10"
                                         Background="Transparent"
                                         Foreground="#1F2937"
                                         BorderBrush="#E5E7EB"
                                         BorderThickness="1"
                                         Padding="5"/>


                                <!-- REMOVE BUTTON -->

                                <Button Grid.Row="3"
                                        Width="38"
                                        Height="38"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource WhiteActionButtonStyle}">

                                    <TextBlock Text="−"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="#17933A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="1"
                            Margin="-25,10,-25,-36"
                            Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,1,1,0"
                            CornerRadius="0,0,18,18">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- ================= SAVE ================= -->

                            <Button Grid.Column="1"
                                    Height="46"
                                    Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Rectangle Width="18"
                                               Height="18"
                                               Fill="{StaticResource SaveIcon}"
                                               Margin="0,0,8,0">

                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>

                                                    <svgc:SvgViewbox Source="/Icons/save.svg"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Stretch="Uniform"/>

                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>

                                    </Rectangle>

                                    <TextBlock Text="Save"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>

                                </StackPanel>

                            </Button>


                            <!-- ================= EXIT ================= -->

                            <Button Grid.Column="3"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Rectangle Width="18"
                                               Height="18"
                                               Fill="{StaticResource ExitIcon}"
                                               Margin="0,0,8,0">

                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>

                                                    <svgc:SvgViewbox Source="/Icons/exit.svg"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Stretch="Uniform"/>

                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>

                                    </Rectangle>

                                    <TextBlock Text="Exit"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>