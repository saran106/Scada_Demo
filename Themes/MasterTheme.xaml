    <Style x:Key="PremiumTextBox"
       TargetType="TextBox">

        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="10,0"/>

        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

        <!-- Premium Dark Colors -->
        <Setter Property="Background" Value="#2A3035"/>
        <Setter Property="Foreground" Value="#F3F6F4"/>

        <Setter Property="BorderBrush" Value="#5F6B62"/>
        <Setter Property="BorderThickness" Value="1.4"/>

        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14"
                        SnapsToDevicePixels="True">

                        <!-- Soft Premium Shadow -->
                        <Border.Effect>

                            <DropShadowEffect
                            BlurRadius="6"
                            ShadowDepth="0"
                            Opacity="0.10"
                            Color="#000000"/>

                        </Border.Effect>

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="10,0"
                                  VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Bd"
                                Property="BorderBrush"
                                Value="#8BCF6A"/>

                            <Setter TargetName="Bd"
                                Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#7FBF5D"
                                    BlurRadius="10"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>

                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused"
                             Value="True">

                            <Setter TargetName="Bd"
                                Property="BorderBrush"
                                Value="#A7E26B"/>

                            <Setter TargetName="Bd"
                                Property="BorderThickness"
                                Value="2"/>

                            <Setter TargetName="Bd"
                                Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#8BCF6A"
                                    BlurRadius="14"
                                    ShadowDepth="0"
                                    Opacity="0.35"/>

                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="Bd"
                                Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


