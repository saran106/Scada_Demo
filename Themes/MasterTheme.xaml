    </Style>

    <!-- LABEL -->
    <Style x:Key="CompactLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,2"/>
        <!-- 🔥 TOP GAP -->
    </Style>

    <Style x:Key="MiniCompactLabel"
       TargetType="TextBlock"
       BasedOn="{StaticResource LabelStyle}">

        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Margin" Value="0,6,0,1"/>
