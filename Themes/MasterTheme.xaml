    <!-- 🔥 HEADER STYLE (DARK) -->
    <!-- =========================
        HEADER TEXT
========================= -->

    <Style x:Key="HeaderTextStyle"
       TargetType="TextBlock">

        <!--<Setter Property="FontFamily" Value="Georgia"/>-->
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>

        <Setter Property="Foreground" Value="#DDF5F5"/>

        <Setter Property="Margin" Value="2,0,0,14"/>

        <Setter Property="TextOptions.TextFormattingMode"
            Value="Display"/>

        <Setter Property="TextOptions.TextRenderingMode"
            Value="ClearType"/>

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                Color="#00D7D7"
                BlurRadius="10"
                ShadowDepth="1"
                Opacity="0.35"/>
            </Setter.Value>
        </Setter>

    </Style>


    <!-- =========================
     PREMIUM DATAGRID HEADER
========================= -->

    <Style x:Key="PremiumDataGridHeaderStyle"
       TargetType="{x:Type DataGridColumnHeader}">

        <Setter Property="Background" Value="#114545"/>
        <Setter Property="Foreground" Value="#F6FFFF"/>

        <Setter Property="BorderBrush" Value="#00A8A8"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>

        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>

        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,5"/>

        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">

                    <Grid ClipToBounds="True">

                        <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,3,0,0">

                            <ContentPresenter
                            Margin="8,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>

                        </Border>

                        <Border Width="1"
                            HorizontalAlignment="Right"
                            Margin="0,8"
                            Background="#36BABA"/>

                        <Thumb x:Name="PART_LeftHeaderGripper"
                           Width="8"
                           HorizontalAlignment="Left"
                           Cursor="SizeWE"
                           Opacity="0"/>

                        <Thumb x:Name="PART_RightHeaderGripper"
                           Width="8"
                           HorizontalAlignment="Right"
                           Cursor="SizeWE"
                           Opacity="0"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#186060"/>

                            <Setter TargetName="HeaderBorder"
                                Property="BorderBrush"
                                Value="#00FFFF"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#1D7070"/>

                        </Trigger>

                        <Trigger Property="SortDirection"
                             Value="Ascending">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#208080"/>

                        </Trigger>

                        <Trigger Property="SortDirection"
                             Value="Descending">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#208080"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- =========================
      DATAGRID CELL
========================= -->

    <Style x:Key="PremiumDataGridCellStyle"
       TargetType="DataGridCell">

        <Setter Property="Background" Value="#173636"/>
        <Setter Property="Foreground" Value="#F2FFFF"/>

        <Setter Property="BorderBrush" Value="#2F5F5F"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>

        <Setter Property="Padding" Value="8,6"/>

    </Style>


    <!-- =========================
       DATAGRID ROW
========================= -->

    <Style x:Key="PremiumDataGridRowStyle"
       TargetType="DataGridRow">

        <Setter Property="Background" Value="#173636"/>
        <Setter Property="Foreground" Value="#F2FFFF"/>

        <Style.Triggers>

            <Trigger Property="AlternationIndex"
                 Value="1">

                <Setter Property="Background"
                    Value="#1B4040"/>

            </Trigger>

            <Trigger Property="IsMouseOver"
                 Value="True">

                <Setter Property="Background"
                    Value="#235050"/>

            </Trigger>

            <Trigger Property="IsSelected"
                 Value="True">

                <Setter Property="Background"
                    Value="#00A8A8"/>

                <Setter Property="Foreground"
                    Value="#081818"/>

                <Setter Property="FontWeight"
                    Value="Bold"/>

            </Trigger>

        </Style.Triggers>

    </Style>

    <Style x:Key="TabButtonStyle" TargetType="Button">

            <!-- SIZE -->
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="#3F4A5A"/>
        <Setter Property="BorderBrush" Value="#7C8794"/>
        <Setter Property="Foreground" Value="#F8F9FA"/>
        <!-- light grey border -->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="MinWidth" Value="95"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                        <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1B6F6F"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#00FFFF"/>
                        </Trigger>

                        <!-- 🔥 ACTIVE -->
                        <!-- ACTIVE -->
                        <Trigger Property="Tag" Value="Active">

                            <Setter TargetName="bd"
            Property="Background"
            Value="#00B8B8"/>

                            <Setter TargetName="bd"
            Property="BorderBrush"
            Value="#00FFFF"/>

                            <Setter TargetName="bd"
            Property="BorderThickness"
            Value="2"/>

                            <!-- Change only this -->
                            <Setter Property="Foreground"
            Value="#0B1F1F"/>

                            <Setter Property="FontWeight"
            Value="Bold"/>

                            <Setter TargetName="bd"
            Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00FFFF"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>

                        </Trigger>

                        <!-- 🔥 CLICK -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F1F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    <Style x:Key="JogTextBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource SystemFieldTextBox}">   

        <!-- SIZE -->
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="MaxWidth" Value="250"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <!-- FONT -->
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- SPACING -->
        <Setter Property="Margin" Value="4,6"/>
        <Setter Property="Padding" Value="6,2"/>

        <!-- REMOVE DEFAULT BORDER -->
        <Setter Property="BorderThickness" Value="0"/>

        <!-- TEMPLATE -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <!-- 🔥 OUTER WHITE BORDER -->
                    <Border Background="White"
                        Padding="2"
                        CornerRadius="2">

                        <!-- INNER DARK BOX -->
                        <Border Background="#2E2E2E"
                            BorderBrush="#555"
