            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14"
                        SnapsToDevicePixels="True">

                        <Border.Effect>

                            <DropShadowEffect
                            BlurRadius="6"
                            ShadowDepth="0"
                            Opacity="0.08"
                            Color="#000000"/>

                        </Border.Effect>

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="10,0"
                                  VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Bd"
                                Property="BorderBrush"
                                Value="#6E8062"/>

                            <Setter TargetName="Bd"
                                Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#A8C08D"
                                    BlurRadius="10"
                                    ShadowDepth="0"
                                    Opacity="0.22"/>

                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused"
                             Value="True">

                            <Setter TargetName="Bd"
                                Property="BorderBrush"
                                Value="#5C8A3C"/>

                            <Setter TargetName="Bd"
                                Property="BorderThickness"
                                Value="2"/>

                            <Setter TargetName="Bd"
                                Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#7FA45C"
                                    BlurRadius="12"
                                    ShadowDepth="0"
                                    Opacity="0.30"/>

                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="Bd"
                                Property="Opacity"
                                Value="0.55"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


