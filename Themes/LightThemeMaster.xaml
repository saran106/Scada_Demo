    <Style x:Key="CompactComboBoxSmall"
   TargetType="ComboBox"
   BasedOn="{StaticResource SystemFieldComboBox}">

        <!-- SIZE -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Width" Value="220"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>

        <!-- SPACING -->
        <Setter Property="Margin" Value="6,8"/>
        <Setter Property="Padding" Value="6,2"/>

        <!-- COLORS -->
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Foreground" Value="White"/>

        <!-- BORDER -->
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="2.5"/>

        <!-- EDITABLE -->
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="IsTextSearchEnabled" Value="True"/>
        <Setter Property="IsTextSearchCaseSensitive" Value="False"/>
        <Setter Property="StaysOpenOnEdit" Value="True"/>

        <!-- 🔥 TEXTBOX INSIDE COMBO FIX -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>

                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3">

                            <Grid>
                                <!-- TEXTBOX -->
                                <TextBox x:Name="PART_EditableTextBox"
                                 Background="Black"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="6,2"
                                 CaretBrush="White"/>

                                <!-- DROPDOWN BUTTON -->
                                <ToggleButton Grid.Column="1"
                                      Width="25"
                                      HorizontalAlignment="Right"
                                      Background="#333"
                                      BorderBrush="White"
                                      BorderThickness="1"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>

                        </Border>

                        <!-- DROPDOWN -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">

                            <Border Background="Black"
                            BorderBrush="White"
                            BorderThickness="1">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>

                        </Popup>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- DROPDOWN ITEMS -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="6"/>

                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#333"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#555"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>
    <!-- =========================
        HEADER TEXT
========================= -->

    <Style x:Key="HeaderTextStyle"
       TargetType="TextBlock">

        <!--<Setter Property="FontFamily" Value="Georgia"/>-->
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>

        <Setter Property="Foreground" Value="#495A42"/>

        <Setter Property="Margin" Value="2,0,0,14"/>

        <Setter Property="TextOptions.TextFormattingMode"
            Value="Display"/>

        <Setter Property="TextOptions.TextRenderingMode"
            Value="ClearType"/>

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                Color="#D8E4CF"
                BlurRadius="8"
                ShadowDepth="1"
                Opacity="0.35"/>
            </Setter.Value>
        </Setter>

    </Style>


    <!-- =========================
     PREMIUM DATAGRID HEADER
========================= -->

    <Style x:Key="PremiumDataGridHeaderStyle"
       TargetType="{x:Type DataGridColumnHeader}">

        <Setter Property="Background" Value="#6E8062"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>

        <Setter Property="BorderBrush" Value="#55664B"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>

        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>

        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,5"/>

        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">

                    <Grid ClipToBounds="True">

                        <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,3,0,0">

                            <ContentPresenter
                            Margin="8,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>

                        </Border>

                        <Border Width="1"
                            HorizontalAlignment="Right"
                            Margin="0,8"
                            Background="#A8B79C"/>

                        <Thumb x:Name="PART_LeftHeaderGripper"
                           Width="8"
                           HorizontalAlignment="Left"
                           Cursor="SizeWE"
                           Opacity="0"/>

                        <Thumb x:Name="PART_RightHeaderGripper"
                           Width="8"
                           HorizontalAlignment="Right"
                           Cursor="SizeWE"
                           Opacity="0"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#7C9070"/>

                            <Setter TargetName="HeaderBorder"
                                Property="BorderBrush"
                                Value="#91A685"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#5E7053"/>

                        </Trigger>

                        <Trigger Property="SortDirection"
                             Value="Ascending">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#55664B"/>

                        </Trigger>

                        <Trigger Property="SortDirection"
                             Value="Descending">

                            <Setter TargetName="HeaderBorder"
                                Property="Background"
                                Value="#55664B"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- =========================
      DATAGRID CELL
========================= -->

    <Style x:Key="PremiumDataGridCellStyle"
       TargetType="DataGridCell">

        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#344054"/>

        <Setter Property="BorderBrush" Value="#D9E3D2"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>

        <Setter Property="Padding" Value="8,6"/>

    </Style>


    <!-- =========================
       DATAGRID ROW
========================= -->

    <Style x:Key="PremiumDataGridRowStyle"
       TargetType="DataGridRow">

        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#344054"/>

        <Style.Triggers>

            <Trigger Property="AlternationIndex"
                 Value="1">

                <Setter Property="Background"
                    Value="#F8FBF6"/>

            </Trigger>

            <Trigger Property="IsMouseOver"
                 Value="True">

                <Setter Property="Background"
                    Value="#EDF4E8"/>

