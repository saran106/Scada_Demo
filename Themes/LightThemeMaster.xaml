<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================= COLORS ================= -->

    <Style TargetType="ToolTip">

        <Setter Property="Background" Value="#2E2E2E"/>
        <Setter Property="Foreground" Value="#F1F5F9"/>

        <Setter Property="BorderBrush" Value="#4B5563"/>
        <Setter Property="BorderThickness" Value="1.2"/>

        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

    </Style>
    <!--<SolidColorBrush x:Key="PrimaryBgBrush" Color="#E6EAEE"/>-->
    <SolidColorBrush x:Key="PrimaryBgBrush" Color="#F5F7F2"/>
    <!--<SolidColorBrush x:Key="PanelBrush" Color="#6E7F91"/>-->
    <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFB"/>

    <SolidColorBrush x:Key="ScadaPrimaryBgBrush" Color="#F5F7F2"/>
    <!--<SolidColorBrush x:Key="ScadaPanelBrush" Color="#E6EAEE"/>-->
    <SolidColorBrush x:Key="ScadaPanelBrush" Color="#F8FAFB"/>
    <!--<SolidColorBrush x:Key="BorderBrushColor" Color="#03346E"/>-->
    <SolidColorBrush x:Key="BorderBrushColor" Color="#A3B49A"/>

    <!-- TEXT -->
    <!--
 <SolidColorBrush x:Key="PrimaryText" Color="#00FFFF"/>-->
    <!-- TEXT -->
    <SolidColorBrush x:Key="PrimaryText" Color="#E6E6E6"/>

    <!-- INPUT -->
    <SolidColorBrush x:Key="DarkInputBg" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="WhiteInputBg" Color="#E6E6E6"/>

    <!-- BUTTON -->
    <SolidColorBrush x:Key="ButtonBg" Color="#002F2F"/>
    <SolidColorBrush x:Key="ButtonText" Color="#3A3A3A"/>


    <!-- ================= TEXT ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- 🔥 ADD THIS -->
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================= HEADER WHITE BOX (TOP SECTION) ================= -->

    <Style x:Key="HeaderTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="{StaticResource WhiteInputBg}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#00FFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= DARK TEXTBOX (LEFT MIXER AREA) ================= -->

    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Width" Value="100"/>

        <Setter Property="Background" Value="{StaticResource DarkInputBg}"/>
        <Setter Property="Foreground" Value="White"/>

        <Setter Property="BorderBrush" Value="#888"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>


    <!-- ================= WHITE TEXTBOX (BOTTOM FORM) ================= -->

    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Width" Value="180"/>

        <Setter Property="Background" Value="{StaticResource WhiteInputBg}"/>
        <Setter Property="Foreground" Value="Black"/>

        <Setter Property="BorderBrush" Value="#00FFFF"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Padding" Value="3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="Button">

        <!-- SIZE -->
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="5,3"/>
        <Setter Property="Padding" Value="14,4"/>

        <!-- COLORS -->
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#6E8062"/>

        <!-- BORDER -->
        <Setter Property="BorderBrush" Value="#55664B"/>
        <Setter Property="BorderThickness" Value="1.5"/>

        <!-- FONT -->
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="bd"
                        CornerRadius="7"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                                <GradientStop Color="#7E9170" Offset="0"/>
                                <GradientStop Color="#6E8062" Offset="0.5"/>
                                <GradientStop Color="#55664B" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- HOVER -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="bd"
                                Property="BorderBrush"
                                Value="#91A685"/>

                            <Setter Property="Foreground"
                                Value="White"/>

                            <Setter TargetName="bd"
                                Property="Background">

                                <Setter.Value>

                                    <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">

                                        <GradientStop Color="#91A685" Offset="0"/>
                                        <GradientStop Color="#7E9170" Offset="0.5"/>
                                        <GradientStop Color="#66785A" Offset="1"/>

                                    </LinearGradientBrush>

                                </Setter.Value>

                            </Setter>

                            <Setter TargetName="bd"
                                Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#6E8062"
                                    BlurRadius="10"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>

                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- CLICK -->
                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter Property="Foreground"
                                Value="White"/>

                            <Setter TargetName="bd"
                                Property="RenderTransform">

                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98"
                                                ScaleY="0.98"/>
                                </Setter.Value>

                            </Setter>

                            <Setter TargetName="bd"
                                Property="Opacity"
                                Value="0.95"/>

                            <Setter TargetName="bd"
                                Property="Effect"
                                Value="{x:Null}"/>

                        </Trigger>

                        <!-- DISABLED -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="bd"
                                Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
    <Style x:Key="GreenButton" TargetType="Button">

        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="5,2"/>
        <Setter Property="Padding" Value="10,3"/>

        <!-- THEME -->
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#4E6D34"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="bd"
                        CornerRadius="5"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                                <GradientStop Color="#8EBF6A" Offset="0"/>
                                <GradientStop Color="#72A24D" Offset="0.5"/>
                                <GradientStop Color="#5C8A3C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- HOVER -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="bd"
                                Property="BorderBrush"
                                Value="#91A685"/>

                            <Setter TargetName="bd"
                                Property="Effect">

                                <Setter.Value>
                                    <DropShadowEffect Color="#6E8062"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.25"/>
                                </Setter.Value>

                            </Setter>

                        </Trigger>

                        <!-- CLICK -->
                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="bd"
                                Property="Background">

                                <Setter.Value>
                                    <SolidColorBrush Color="#91A685"/>
                                </Setter.Value>

                            </Setter>

                            <Setter Property="Foreground"
                                Value="White"/>

                        </Trigger>

                        <!-- DISABLED -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="bd"
                                Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
