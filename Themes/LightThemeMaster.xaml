                                </Setter.Value>

                            </Setter>

                            <Setter TargetName="bd"
                                Property="Opacity"
                                Value="0.95"/>

                            <Setter TargetName="bd"
                                Property="Effect"
                                Value="{x:Null}"/>

                        </Trigger>

                        <!-- DISABLED -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="bd"
                                Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

