<Window x:Class="Scada_Demo.Login.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600"
        Height="350"
        Title="Login">

    <Grid Background="#55000000">

        <Border Width="520"
                Height="300"
                Padding="20"
                Background="{StaticResource ScadaPanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <!-- LOGIN -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="LOGIN"
                           Style="{StaticResource HeaderTextStyle}"/>

                <!-- LANGUAGE -->

                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Width="200"
                          HorizontalAlignment="Right"
                          Style="{StaticResource CompactComboBoxSmall}">
                    <ComboBoxItem IsSelected="True">
                        English (Default)
                    </ComboBoxItem>
                </ComboBox>

                <!-- USER -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="User Name"
                           Style="{StaticResource LabelStyle}"/>

                <TextBox x:Name="txtUser"
                         Grid.Row="1"
                         
                         Grid.Column="1"
 Height="35"
 Margin="5"
 Background="#2B2B2B"
 Foreground="White"
 BorderBrush="White"
 BorderThickness="2"/>


                <!-- PASSWORD -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Password"
                           Style="{StaticResource LabelStyle}"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="35"
                             Margin="5"
                             Background="#2B2B2B"
                             Foreground="White"
                             BorderBrush="White"
                             BorderThickness="2"/>

                <!-- SHOW PASSWORD -->

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="5"
                        Content="👁"/>

                <!-- BUTTONS -->

                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="btnLogin"
                            Width="160"
                            Height="40"
                            Content="Login"
                            Style="{StaticResource GreenButton}"
                            Click="btnLogin_Click"/>

                    <Button x:Name="btnCancel"
                            Width="160"
                            Height="40"
                            Content="Cancel"
                            Style="{StaticResource RedButton}"
                            Click="btnCancel_Click"/>

                </StackPanel>

                <!-- VERSION -->

                <TextBlock Grid.Row="4"
                           Grid.ColumnSpan="3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Foreground="White"
                           FontStyle="Italic"
                           FontSize="11"
                           Text="Version 1.0.0"/>

            </Grid>

        </Border>

    </Grid>

</Window>