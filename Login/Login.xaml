<Window x:Class="Scada_Demo.Login.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BatchLite"
        Width="1090"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        Icon="../project_small_i.png">

    <Window.Resources>
        <!-- PRIMARY BUTTON -->
        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
       TargetType="Button">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="BorderBrush"
        Value="#66785B"/>

            <Setter Property="BorderThickness"
        Value="1"/>

            <Setter Property="Foreground"
        Value="White"/>
            <Setter Property="Height"
            Value="42"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Background"
        Value="#66785B"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="10">

                            <ContentPresenter
    Content="{TemplateBinding Content}"
    ContentTemplate="{TemplateBinding ContentTemplate}"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    RecognizesAccessKey="False"/>

                        </Border>

                        <!-- IMPORTANT -->
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                Value="{Binding Foreground,
                                RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Style>
                        </ControlTemplate.Resources>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">
                                <Setter TargetName="Bd"
                                Property="Opacity"
                                Value="0.90"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">
                                <Setter TargetName="Bd"
                                Property="Opacity"
                                Value="0.75"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
            Value="#E5E7EB"/>

            <Setter Property="Foreground"
            Value="#374151"/>

            <Setter Property="BorderBrush"
        Value="#D1D5DB"/>

            <Setter Property="Foreground"
        Value="#374151"/>

        </Style>

        <!-- ================================================= -->
        <!-- COLORS -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#66785B"/>

        <SolidColorBrush x:Key="AccentLightBrush"
                         Color="#EEF4EA"/>

        <SolidColorBrush x:Key="DarkBrush"
                         Color="#202938"/>

        <SolidColorBrush x:Key="GrayBrush"
                         Color="#6B7280"/>

        <SolidColorBrush x:Key="BorderBrushEx"
                         Color="#E5E7EB"/>

        <SolidColorBrush x:Key="CardBrush"
                         Color="White"/>

        <LinearGradientBrush x:Key="LoginGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">

            <GradientStop Offset="0"
                          Color="#738A69"/>

            <GradientStop Offset="1"
                          Color="#607755"/>

        </LinearGradientBrush>

        <!-- ================================================= -->
        <!-- DEFAULT TEXT -->
        <!-- ================================================= -->

        <Style TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

        </Style>

        <Style x:Key="TitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="30"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>

        <Style x:Key="SubtitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="{StaticResource GrayBrush}"/>

        </Style>

        <Style x:Key="LabelStyle"
       TargetType="TextBlock">

            <Setter Property="FontSize"
            Value="16"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

        </Style>

        <Style x:Key="InputBorder"
               TargetType="Border">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D8DDE3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style TargetType="TextBox">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style TargetType="PasswordBox">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="22"/>

            <Setter Property="Padding"
                    Value="42"/>

            <Setter Property="BorderBrush"
                    Value="#E7EAEE"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </Window.Resources>

    <!-- ================================================= -->
    <!-- MAIN ROOT -->
    <!-- ================================================= -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="49*"/>
        </Grid.RowDefinitions>

        <!-- FULL BACKGROUND -->

        <Image Source="../Login_bg_new.png"
               Stretch="Fill" Grid.RowSpan="2"/>

        <!-- Right Side Light Overlay -->

        <Rectangle Grid.RowSpan="2">

            <Rectangle.Fill>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                    <GradientStop Offset="0"
                                  Color="#00FFFFFF"/>

                    <GradientStop Offset="0.72"
                                  Color="#25FFFFFF"/>

                    <GradientStop Offset="1"
                                  Color="#D8FFFFFF"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <!-- ================================================= -->
        <!-- TOP HEADER -->
        <!-- ================================================= -->

        <Grid VerticalAlignment="Top"
              Margin="40,28,40,0"
              Height="55">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="220"/>

            </Grid.ColumnDefinitions>

            <!-- Logo -->


            <!-- Language -->

            <Border Grid.Column="1"
                    Width="200"
                    Height="42"
                    HorizontalAlignment="Right"
                    CornerRadius="10"
                    Background="#FDFDFD"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1">

                <Grid Margin="10,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="28"/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🌐"
                               FontSize="18"
                               Foreground="{StaticResource GrayBrush}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedIndex="0">

                        <ComboBoxItem Content="English (Default)"/>

                    </ComboBox>

                </Grid>

            </Border>

        </Grid>

        <!-- ================================================= -->
        <!-- LEFT TITLE -->
        <!-- ================================================= -->

        <StackPanel Margin="50,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <TextBlock Style="{StaticResource TitleStyle}">
        <Run Text="Batching Plant "/>
        <Run Text="SCADA"
             Foreground="{StaticResource AccentBrush}"/>
        <Run Text=" System"/>
            </TextBlock>

            <Border Width="430"
            Height="2"
            Margin="-10,6,0,6"
            CornerRadius="3"
            Background="{StaticResource AccentBrush}"/>

            <TextBlock Style="{StaticResource SubtitleStyle}"
               Text="Smart Control. Accurate Batching. Maximum Performance."
               Margin="0,0,0,0"/>

        </StackPanel>

        <!-- Decorative Dots -->

        <UniformGrid Width="72"
                     Height="72"
                     Rows="5"
                     Columns="5"
                     Margin="0,120,90,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top">

            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>

            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>

            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>

            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>

            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>
            <Ellipse Fill="#D6DBE2"/>

        </UniformGrid>

        <!-- ================================================= -->
        <!-- FLOATING LOGIN CARD -->
        <!-- ================================================= -->

        <Border Width="450"
                Height="480"
                Style="{StaticResource CardStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="590,88,0,0" Grid.RowSpan="2">


            <Grid>

                <Grid.RowDefinitions>


                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>


                </Grid.RowDefinitions>

                <!-- ===================================== -->
                <!-- LOGO -->
                <!-- ===================================== -->

                <StackPanel HorizontalAlignment="Center">

                    <Border Width="74"
            Height="74"
            CornerRadius="37"
            Background="{StaticResource AccentLightBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">

                        <Image Source="../project_small_i.png"
               Width="46"
               Height="46"
               Stretch="Uniform"/>

                    </Border>

                    <TextBlock Margin="0,14,0,0"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center">

        <Run Text="Batch"/>
        <Run Text="Lite"
             Foreground="{StaticResource AccentBrush}"/>

                    </TextBlock>

                    <TextBlock Text="Please sign in to continue"
               FontSize="13"
               Margin="0,4,0,0"
               HorizontalAlignment="Center"
               Foreground="#6B7280"/>

                </StackPanel>

                <!-- ===================================== -->
                <!-- USERNAME -->
                <!-- ===================================== -->

                <StackPanel Grid.Row="2">

                    <TextBlock Text="Username"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="2,0,0,6"/>

                    <Border Height="42"
            CornerRadius="10"
            BorderBrush="#D8DDE3"
            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                       Text="👤"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"/>

                            <TextBox Grid.Column="1"
                     FontSize="14"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding UserName}"/>

                        </Grid>

                    </Border>

                </StackPanel>

                <!-- ===================================== -->
                <!-- PASSWORD -->
                <!-- ===================================== -->

                <StackPanel Grid.Row="4">

                    <TextBlock Text="Password"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="2,0,0,6"/>

                    <Border Height="42"
            CornerRadius="10"
            BorderBrush="#D8DDE3"
            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                       Text="🔒"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"/>

                            <PasswordBox Grid.Column="1"
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <TextBlock Grid.Column="2"
                       Text="👁"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#9CA3AF"/>

                        </Grid>

                    </Border>

                </StackPanel>

                <!-- ===================================== -->
                <!-- BUTTONS -->
                <!-- ===================================== -->

                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
        Style="{StaticResource PrimaryButtonStyle}"
        Content="LOGIN"
        Foreground="White"
        Command="{Binding LoginCommand}"/>

                    <Button Grid.Column="2"
        Style="{StaticResource SecondaryButtonStyle}"
        Content="CANCEL"
        Foreground="#374151"
        Command="{Binding CancelCommand}"/>
                </Grid>

                <!-- ===================================== -->
                <!-- SECURE ACCESS -->
                <!-- ===================================== -->

                <StackPanel Grid.Row="9"
            VerticalAlignment="Bottom">

                    <Separator Margin="0,12,0,10"/>

                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                   FontSize="15"
                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="Secure Access to BatchLite SCADA"
                   Margin="6,0,0,0"
                   FontSize="12"
                   Foreground="{StaticResource GrayBrush}"
                   VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- FOOTER OVERLAY -->
        <!-- ================================================= -->
        <Border Height="80"
        Margin="40,336,40,0"
        VerticalAlignment="Top"
        CornerRadius="20"
        Background="#66FFFFFF"
        BorderBrush="#55FFFFFF"
        BorderThickness="1"
        Padding="18,10" Grid.Row="1">
            <Grid 
              
              Height="62">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="80"/>

                </Grid.ColumnDefinitions>

                <!-- ================= LIVE ================= -->

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="#AAFFFFFF">

                        <TextBlock Text="🖥"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="Live"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="Process Monitoring"
                               FontSize="13"
                               Foreground="{StaticResource GrayBrush}"/>

                    </StackPanel>

                </StackPanel>

                <!-- ================= RELIABILITY ================= -->

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="#AAFFFFFF">

                        <TextBlock Text="🛡"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="99.9%"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="System Reliability"
                               FontSize="13"
                               Foreground="{StaticResource GrayBrush}"/>

                    </StackPanel>

                </StackPanel>

                <!-- ================= SUPPORT ================= -->

                <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                      Background="#44FFFFFF">

                        <TextBlock Text="🎧"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="24×7"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="Technical Support"
                               FontSize="13"
                               Foreground="{StaticResource GrayBrush}"/>

                    </StackPanel>

                </StackPanel>

                <!-- ================= COPYRIGHT ================= -->

                <StackPanel Grid.Column="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                    <TextBlock Text="© 2026 Elantris Technologies Pvt. Ltd."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="All Rights Reserved."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#F3F4F6"
                           HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- ================= LOGO ================= -->

                <Border Grid.Column="4"
                    Width="60"
                    Height="60"
                    CornerRadius="15"
                    Background="#AAFFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Image Source="../project_small_i.png"
                       Width="44"
                       Height="44"
                       Stretch="Uniform"/>

                </Border>

            </Grid>
        </Border>
    </Grid>

</Window>