<Window x:Class="Scada_Demo.Batch_Settings.Discharge_Sequence"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC460 Discharge Sequence Settings"
        Height="470" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Discharge delay sequence in terms of seconds"
                   Style="{DynamicResource HeaderTextStyle}"
                   Margin="5,5,5,10"/>

        <!-- MAIN PANEL -->
        <Border Grid.Row="1"
                Padding="15"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6" Margin="0,0,0,36">

            <Grid>

                <!-- PERFECT GRID ALIGNMENT -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LEFT SIDE -->
                <TextBlock Text="Cement" Grid.Row="0" Grid.Column="0" Style="{DynamicResource CompactLabel}" Width="70"/>
                <TextBox x:Name="Cem" Text="{Binding Cement, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <TextBlock Text="Water" Grid.Row="1" Grid.Column="0" Style="{DynamicResource CompactLabel}" Width="70"/>
                <TextBox x:Name="Wat" Text="{Binding Water, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <TextBlock Text="Wtr2" Grid.Row="2" Grid.Column="0" Style="{DynamicResource CompactLabel}" Width="70"/>
                <TextBox Grid.Row="2"  Grid.Column="1" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <!-- RIGHT SIDE -->
                <TextBlock Text="Admixture 1 &amp; 2" Grid.Row="0" Grid.Column="3" Style="{DynamicResource CompactLabel}" Width="120"/>
                <TextBox x:Name="Admix12" Text="{Binding Admix, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="4" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <TextBlock Text="Admixture 3 &amp; 4" Grid.Row="1" Grid.Column="3" Style="{DynamicResource CompactLabel}" Width="120"/>
                <TextBox  x:Name="Admix34" Grid.Row="1" Grid.Column="4" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <TextBlock Text="Silica" Grid.Row="2" Grid.Column="3" Style="{DynamicResource CompactLabel}" Width="120"/>
                <TextBox Grid.Row="2" Grid.Column="4" Style="{DynamicResource JogTextBoxStyle}"  Width="200"  Height="34"/>

                <!-- EXTRA -->
                <TextBlock Text="Water pump cutoff in kg"
                           Grid.Row="4" Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Style="{DynamicResource CompactLabel}"/>

                <TextBox Grid.Row="4" Grid.Column="3"
                         Grid.ColumnSpan="2"
                         x:Name="PC"
                         Text="{Binding PumpCutOff, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}" Width="200"  Height="34"/>

                <TextBlock Text="Waiting hopper instant open delay in sec"
                           Grid.Row="5" Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Style="{DynamicResource CompactLabel}"/>

                <TextBox Grid.Row="5" Grid.Column="3"
                         Grid.ColumnSpan="2"
                         x:Name="Skip"
                         Text="{Binding Skip, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}" Width="200"  Height="34"/>

            </Grid>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button Content="Read from PLC"
        Width="140"
        Command="{Binding ReadFromPlcCommand}"/>

            <Button Content="Write to PLC / DB"
        Width="170"
        Style="{DynamicResource GreenButton}"
        Command="{Binding WriteToPlcCommand}"/>

            <Button Content="Exit"
        Width="110"
        Style="{DynamicResource RedButton}"
        Command="{Binding ExitCommand}"/>

        </StackPanel>

    </Grid>
</Window>