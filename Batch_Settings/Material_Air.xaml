<Window x:Class="Scada_Demo.Batch_Settings.Material_Air"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Batch_Settings"
        mc:Ignorable="d"
        Height="400" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Material in air in terms of milliseconds"
                   Margin="5"
                   Style="{DynamicResource HeaderTextStyle}"/>

        <!-- TAB BUTTONS -->
        <StackPanel x:Name="TabButtons"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="5">
            <Button Content="Aggregate"
        Command="{Binding ShowAggregateCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Aggregate">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Cement"
        Command="{Binding ShowCementCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Cement">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Water"
        Command="{Binding ShowWaterCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Water">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Admixture"
        Command="{Binding ShowAdmixCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Admixture">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Micro Silica"
        Command="{Binding ShowSilicaCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Micro Silica">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- CONTENT -->
        <Border Grid.Row="2"
                Margin="5"
                Padding="20"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <!-- ================= AGGREGATE ================= -->
                <Grid x:Name="AggregatePanel" Margin="10" Visibility="{Binding AggregateVisibility}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT SIDE -->

                    <!-- Agg1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg1"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg1"
                 Text="{Binding txtAgg1, UpdateSourceTrigger=PropertyChanged}"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Width="180"  Height="34" />
                    </StackPanel>

                    <!-- Agg2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg2"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg2" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg2, UpdateSourceTrigger=PropertyChanged}"
                 Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Agg3 -->
                    <StackPanel Grid.Row="2" Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg3"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg3" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg3, UpdateSourceTrigger=PropertyChanged}"
                 Width="180"  Height="34"/>
                    </StackPanel>


                    <!-- RIGHT SIDE -->

                    <!-- Agg4 -->
                    <StackPanel Grid.Row="0" Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg4"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg4" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg4, UpdateSourceTrigger=PropertyChanged}"
                 Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Agg5 -->
                    <StackPanel Grid.Row="1" Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg5"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg5" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg5, UpdateSourceTrigger=PropertyChanged}"
                 Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Agg6 -->
                    <StackPanel Grid.Row="2" Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Agg6"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAgg6" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg6, UpdateSourceTrigger=PropertyChanged}"
                 Width="180"  Height="34"/>
                    </StackPanel>

                </Grid>

                <!-- ================= CEMENT ================= -->
                <Grid x:Name="CementPanel" Margin="10" Visibility="{Binding CementVisibility}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT SIDE -->
                    <!-- Cem1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Cem1"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtC1" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC1, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Cem2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Cem2"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtC2" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC2, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Cem3 -->
                    <StackPanel Grid.Row="2" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Cem3"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtC3" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC3, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>


                    <!-- RIGHT SIDE -->

                    <!-- Cem4 -->
                    <StackPanel Grid.Row="0" Grid.Column="2"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Cem4"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtC4" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC4, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Cem5 -->
                    <StackPanel Grid.Row="1" Grid.Column="2"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Cem5"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtC5" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC5, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                </Grid>

                <!-- ================= WATER ================= -->
                <Grid x:Name="WaterPanel" Margin="10" Visibility="{Binding WaterVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT SIDE -->
                    <!-- Wtr1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Wtr1"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtWTR1" Text="{Binding txtWTR1, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource JogTextBoxStyle}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Wtr2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Wtr2"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtWTR2" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtWTR2, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Wtr3 -->
                    <StackPanel Grid.Row="2" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Wtr3"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtWTR3" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtWTR3, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                </Grid>

                <!-- ================= ADMIX ================= -->
                <Grid x:Name="AdmixPanel" Margin="10" Visibility="{Binding AdmixVisibility}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Admix1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Admix1"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAD1" Text="{Binding txtAD1, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource JogTextBoxStyle}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Admix2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Admix2"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAD2" Text="{Binding txtAD2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource JogTextBoxStyle}"
  Width="180"  Height="34"/>
                    </StackPanel>


                    <!-- RIGHT SIDE -->

                    <!-- Admix3 -->
                    <StackPanel Grid.Row="0" Grid.Column="2"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Admix3"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAD3" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD3, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                    <!-- Admix4 -->
                    <StackPanel Grid.Row="1" Grid.Column="2"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Admix4"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtAD4" Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD4, UpdateSourceTrigger=PropertyChanged}"
  Width="180"  Height="34"/>
                    </StackPanel>

                </Grid>

                <!-- ================= SILICA ================= -->
                <Grid x:Name="SilicaPanel" Margin="10" Visibility="{Binding SilicaVisibility}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Silica -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                        <TextBlock Text="Silica"
    Width="70"
    Style="{DynamicResource CompactLabel}"/>

                        <TextBox x:Name="txtICE" Text="{Binding txtICE, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource JogTextBoxStyle}"
  Width="180"  Height="34"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- BUTTONS -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="Read from PLC" Width="130" Command="{Binding ReadFromPlcCommand}"/>
            <Button Content="Write to PLC / DB" Width="160" Command="{Binding WriteToPlcCommand}"/>

            <Button Content="Exit" Width="100" Style="{DynamicResource RedButton}" Command="{Binding ExitCommand}"/>

        </StackPanel>

    </Grid>
</Window>
