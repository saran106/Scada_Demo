<Window x:Class="Scada_Demo.Batch_Settings.Material_Air"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Batch_Settings"
           xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"

        mc:Ignorable="d"
             Width="780"
    Height="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
       Background="{DynamicResource SitePageBackgroundBrush}">



    <Border Margin="12"
          Style="{DynamicResource SiteOuterBorderStyle}">

        <Border.Effect>

            <DropShadowEffect BlurRadius="18"
                            ShadowDepth="2"
                            Color="Black"
                            Opacity="0.12"/>

        </Border.Effect>

        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="64"/>
                <RowDefinition Height="85"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->

            <Grid Grid.Row="0"
         Margin="0,-28,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="48"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Border Width="40"
               Height="40"
               VerticalAlignment="Center"
               Style="{DynamicResource SiteIconBoxStyle}">

                    <Image Source="/Icons/Pincode.png"
                  Width="22"
                  Height="22"/>

                </Border>

                <TextBlock Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Text="Material in Air"
                  Style="{DynamicResource SiteHeaderStyle}"/>

                <Grid Grid.ColumnSpan="3"
             VerticalAlignment="Bottom"
             Margin="0,0,0,18">

                    <Border Height="1.5"
                   Background="{DynamicResource SiteAccentBrush}"/>

                    <Ellipse Width="10"
                    Height="10"
                    HorizontalAlignment="Right"
                    Fill="{DynamicResource SiteAccentBrush}"/>

                </Grid>

            </Grid>
            <!-- ================= TAB AREA ================= -->

            <Border Grid.Row="1"
                Background="#F8FAF8"
                BorderBrush="#D8E2DA"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">

                <UniformGrid Rows="1"
                         Columns="5">

                    <Button Content="Aggregate"
Height="42"
Margin="3"
Command="{Binding ShowAggregateCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
       BasedOn="{StaticResource SiteTabButtonStyle}">

                                <Setter Property="Tag" Value=""/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedTab}"
                     Value="Aggregate">

                                        <Setter Property="Tag"
                    Value="Active"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- ================= CEMENT ================= -->

                    <Button Content="Cement"
Height="42"
Margin="3"
Command="{Binding ShowCementCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
       BasedOn="{StaticResource SiteTabButtonStyle}">

                                <Setter Property="Tag" Value=""/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedTab}"
                     Value="Cement">

                                        <Setter Property="Tag"
                    Value="Active"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- ================= WATER ================= -->

                    <Button Content="Water"
Height="42"
Margin="3"
Command="{Binding ShowWaterCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
       BasedOn="{StaticResource SiteTabButtonStyle}">

                                <Setter Property="Tag" Value=""/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedTab}"
                     Value="Water">

                                        <Setter Property="Tag"
                    Value="Active"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- ================= ADMIXTURE ================= -->

                    <Button Content="Admixture"
Height="42"
Margin="3"
Command="{Binding ShowAdmixCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
       BasedOn="{StaticResource SiteTabButtonStyle}">

                                <Setter Property="Tag" Value=""/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedTab}"
                     Value="Admixture">

                                        <Setter Property="Tag"
                    Value="Active"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- ================= MICRO SILICA ================= -->

                    <Button Content="Micro Silica"
Height="42"
Margin="3"
Command="{Binding ShowSilicaCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
       BasedOn="{StaticResource SiteTabButtonStyle}">

                                <Setter Property="Tag" Value=""/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedTab}"
                     Value="Micro Silica">

                                        <Setter Property="Tag"
                    Value="Active"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                </UniformGrid>

            </Border>
            <!-- ===================================================== -->
            <!-- CONTENT AREA -->
            <!-- ===================================================== -->

            <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">

                <Grid>

                    <!-- ===================================================== -->
                    <!-- AGGREGATE VIEW -->
                    <!-- ===================================================== -->

                    <Grid Visibility="{Binding AggregateVisibility}">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
