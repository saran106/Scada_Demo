                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ================= LEFT PANEL ================= -->

                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="54"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="54"/>
                                <RowDefinition Height="8"/>

                                <RowDefinition Height="54"/>

                            </Grid.RowDefinitions>

                            <!-- ================= AGG1 ================= -->

                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <!-- ICON -->
                                <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                                    <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>

                                                    <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>

                                    </Rectangle>


                                </Border>

                                <TextBlock Grid.Column="1"
