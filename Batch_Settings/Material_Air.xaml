               VerticalAlignment="Center"
               Text="Silica"
               Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox Grid.Column="2"
             Width="130"
             Height="40"
             HorizontalAlignment="Left"
             Margin="0,0,10,0"
             Text="{Binding txtICE, UpdateSourceTrigger=PropertyChanged}"
             Style="{DynamicResource SiteTextBoxStyle}"/>

                        <TextBlock Grid.Column="3"
               Text="ms"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               Style="{DynamicResource SiteLabelStyle}"/>

                    </Grid>

                </Grid>

            </Border>

            <!-- ===================================================== -->
            <!-- FOOTER -->
            <!-- ===================================================== -->

            <Border Grid.Row="3"
        Margin="-19,8,-19,-22"
        Background="#F8F9FB"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

                <Grid Margin="16,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="170"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="185"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="125"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- ================= READ ================= -->

                    <Button Grid.Column="1"
                Height="46"
                Command="{Binding ReadFromPlcCommand}"
                Style="{StaticResource SaveButtonStyle}">

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                            <Image Source="/Icons/Pincode.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                            <TextBlock Text="Read from PLC"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                        </StackPanel>

                    </Button>

                    <!-- ================= WRITE ================= -->

                    <Button Grid.Column="3"
                Height="46"
                Command="{Binding WriteToPlcCommand}"
                Style="{StaticResource WhiteActionButtonStyle}">

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                            <Image Source="/Icons/Pincode.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                            <TextBlock Text="Write PLC / DB"
                           Foreground="#1F2937"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                        </StackPanel>

                    </Button>

                    <!-- ================= EXIT ================= -->

                    <Button Grid.Column="5"
        Width="125"
        Height="46"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="0"
        Command="{Binding ExitCommand}"
        Style="{StaticResource WhiteActionButtonStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
               Source="/Icons/exit.png"
               Width="18"
               Height="18"
               VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                   Text="Exit"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Foreground="#1F2937"
                   FontSize="14"
                   FontWeight="SemiBold"/>

                        </Grid>

                    </Button>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
