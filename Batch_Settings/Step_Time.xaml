<!--<Window x:Class="Scada_Demo.Batch_Settings.Step_Time"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step_Time"
        Height="420" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        --><!-- HEADER --><!--
        <TextBlock Text="Step Time"
                   Margin="5"
                   Style="{DynamicResource HeaderTextStyle}"/>

        --><!-- TABS --><!--
        <StackPanel x:Name="TabButtons"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="5">

            --><!--<Button Content="Aggregate" Style="{DynamicResource TabButtonStyle}" Click="ShowAggregate"/>
            <Button Content="Cement" Style="{DynamicResource TabButtonStyle}" Click="ShowCement"/>
            <Button Content="Water" Style="{DynamicResource TabButtonStyle}" Click="ShowWater"/>
            <Button Content="Admixture" Style="{DynamicResource TabButtonStyle}" Click="ShowAdmix"/>
            <Button Content="Micro Silica" Style="{DynamicResource TabButtonStyle}" Click="ShowSilica"/>--><!--

            <Button Content="Aggregate"
        Command="{Binding ShowAggregateCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Aggregate">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Cement"
        Command="{Binding ShowCementCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Cement">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Water"
        Command="{Binding ShowWaterCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Water">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Admixture"
        Command="{Binding ShowAdmixCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Admixture">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Micro Silica"
        Command="{Binding ShowSilicaCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Micro Silica">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        --><!-- CONTENT --><!--
        <Border Grid.Row="2"
                Margin="5"
                Padding="20"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                --><!-- ================= AGG ================= --><!--
                <Grid Visibility="{Binding AggregateVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    --><!-- LEFT --><!--

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Agg1" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg1, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Agg2" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg2, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Agg3" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg3, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    --><!-- RIGHT --><!--

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Agg4" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg4, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Agg5" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg5, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Agg6" Width="70" Style="{DynamicResource CompactLabel}"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAgg6, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                </Grid>


                --><!-- ================= CEMENT ================= --><!--
                <Grid Visibility="{Binding CementVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    --><!-- LEFT --><!--

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Cem1" Width="70"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC1, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Cem2" Width="70"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC2, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Cem3" Width="70"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC3, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    --><!-- RIGHT --><!--

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Cem4" Width="70"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC4, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Cem5" Width="70"/>
                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtC5, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="sec" Margin="10,0,0,0"/>
                    </StackPanel>

                </Grid>

                --><!-- WATER --><!--
                <Grid Visibility="{Binding WaterVisibility}" Margin="10">

                    <StackPanel Orientation="Vertical">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Wtr1" Width="70"/>
                            <TextBox Width="120"
                     Height="34"
                     Style="{DynamicResource JogTextBoxStyle}"
                     Text="{Binding txtWTR1, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="sec" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Wtr2" Width="70"/>
                            <TextBox Width="120"
                     Height="34"
                     Style="{DynamicResource JogTextBoxStyle}"
                     Text="{Binding txtWTR2, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="sec" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Wtr3" Width="70"/>
                            <TextBox Width="120"
                     Height="34"
                     Style="{DynamicResource JogTextBoxStyle}"
                     Text="{Binding txtWTR3, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="sec" Margin="10,0,0,0"/>
                        </StackPanel>

                    </StackPanel>

                </Grid>

                --><!-- ADMIX --><!--
                <Grid Visibility="{Binding AdmixVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    --><!-- Admix1 --><!--
                    <StackPanel Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Admix1"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD1, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="sec"
                   Margin="10,0,0,0"
                   Style="{DynamicResource CompactLabel}"/>
                    </StackPanel>

                    --><!-- Admix2 --><!--
                    <StackPanel Grid.Row="1"
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Admix2"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD2, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="sec"
                   Margin="10,0,0,0"
                   Style="{DynamicResource CompactLabel}"/>
                    </StackPanel>

                    --><!-- Admix3 --><!--
                    <StackPanel Grid.Row="0"
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Admix3"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD3, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="sec"
                   Margin="10,0,0,0"
                   Style="{DynamicResource CompactLabel}"/>
                    </StackPanel>

                    --><!-- Admix4 --><!--
                    <StackPanel Grid.Row="1"
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Admix4"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtAD4, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="sec"
                   Margin="10,0,0,0"
                   Style="{DynamicResource CompactLabel}"/>
                    </StackPanel>

                </Grid>

                --><!-- SILICA --><!--
                <Grid Visibility="{Binding SilicaVisibility}" Margin="10">

                    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                        <TextBlock Text="Silica"
                   Width="70"
                   Style="{DynamicResource CompactLabel}"/>

                        <TextBox Width="120"
                 Height="34"
                 Style="{DynamicResource JogTextBoxStyle}"
                 Text="{Binding txtSilica, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="sec"
                   Margin="10,0,0,0"
                   Style="{DynamicResource CompactLabel}"/>

                    </StackPanel>

                </Grid>

            </Grid>
        </Border>

        --><!-- BUTTONS --><!--
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">
            <Button Content="Read from PLC"
        Width="130"
        Command="{Binding ReadFromPlcCommand}"/>

            <Button Content="Write to PLC / DB"
        Width="160"
        Command="{Binding WriteToPlcCommand}"/>

            <Button Content="Exit"
        Width="100"
        Style="{DynamicResource RedButton}"
        Command="{Binding ExitCommand}"/>
        </StackPanel>

    </Grid>
</Window>-->


<Window x:Class="Scada_Demo.Batch_Settings.Step_Time"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step_Time"
             Width="780"
    Height="550"
           xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>

                    <RowDefinition Height="64"/>
                    <RowDefinition Height="85"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="82"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-28,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="48"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/Pincode.png"
                               Width="22"
                               Height="22"/>

                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Step Time"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <Grid Grid.ColumnSpan="3"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,18">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 HorizontalAlignment="Right"
                                 Fill="{DynamicResource SiteAccentBrush}"/>

                    </Grid>

                </Grid>

                <!-- ================= TAB AREA ================= -->

                <Border Grid.Row="1"
                        Background="#F8FAF8"
                        BorderBrush="#D8E2DA"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8">

                    <UniformGrid Rows="1"
                                 Columns="5">

                        <Button Content="Aggregate"
        Height="42"
        Margin="3"
        Command="{Binding ShowAggregateCommand}">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SiteTabButtonStyle}">

                                    <Setter Property="Tag" Value=""/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedTab}"
                             Value="Aggregate">

                                            <Setter Property="Tag"
                            Value="Active"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <!-- ================= CEMENT ================= -->

                        <Button Content="Cement"
        Height="42"
        Margin="3"
        Command="{Binding ShowCementCommand}">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SiteTabButtonStyle}">

                                    <Setter Property="Tag" Value=""/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedTab}"
                             Value="Cement">

                                            <Setter Property="Tag"
                            Value="Active"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <!-- ================= WATER ================= -->

                        <Button Content="Water"
        Height="42"
        Margin="3"
        Command="{Binding ShowWaterCommand}">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SiteTabButtonStyle}">

                                    <Setter Property="Tag" Value=""/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedTab}"
                             Value="Water">

                                            <Setter Property="Tag"
                            Value="Active"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <!-- ================= ADMIXTURE ================= -->

                        <Button Content="Admixture"
        Height="42"
        Margin="3"
        Command="{Binding ShowAdmixCommand}">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SiteTabButtonStyle}">

                                    <Setter Property="Tag" Value=""/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedTab}"
                             Value="Admixture">

                                            <Setter Property="Tag"
                            Value="Active"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <!-- ================= MICRO SILICA ================= -->

                        <Button Content="Micro Silica"
        Height="42"
        Margin="3"
        Command="{Binding ShowSilicaCommand}">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SiteTabButtonStyle}">

                                    <Setter Property="Tag" Value=""/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedTab}"
                             Value="Micro Silica">

                                            <Setter Property="Tag"
                            Value="Active"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                    </UniformGrid>

                </Border>

                <!-- ================= CONTENT AREA ================= -->

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">

                    <Grid>

                        <!-- ===================================================== -->
                        <!-- AGGREGATE VIEW -->
                        <!-- ===================================================== -->

                        <Grid Visibility="{Binding AggregateVisibility}">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- ================= LEFT PANEL ================= -->

                            <Grid Grid.Column="0">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="54"/>

                                </Grid.RowDefinitions>

                                <!-- ================= AGG1 ================= -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ICON -->
                                    <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>
                                    <TextBlock Grid.Column="1"
   VerticalAlignment="Center"
   Text="Agg1"
   Style="{DynamicResource SiteLabelStyle}"/>

                                    <TextBox Grid.Column="2"
 Height="40"
  Margin="0,0,12,0"
 Text="{Binding txtAgg1, UpdateSourceTrigger=PropertyChanged}"
 Style="{DynamicResource SiteTextBoxStyle}"/>

                                    <TextBlock Grid.Column="3"
         Text="sec"
         VerticalAlignment="Center"
         Style="{DynamicResource SiteLabelStyle}"/>
                                </Grid>

                                <Border Grid.Row="0"
                VerticalAlignment="Bottom"
                Height="1"
                Background="#E7EBEF"/>

                                <!-- ================= AGG2 ================= -->

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>

                                    <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Agg2"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                    <TextBox Grid.Column="2"
  Margin="0,0,12,0"
                     Height="40"
                     Text="{Binding txtAgg2, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource SiteTextBoxStyle}"/>


                                    <TextBlock Grid.Column="3"
Text="sec"
VerticalAlignment="Center"
Style="{DynamicResource SiteLabelStyle}"/>

                                </Grid>

                                <Border Grid.Row="2"
                VerticalAlignment="Bottom"
                Height="1"
                Background="#E7EBEF"/>

                                <!-- ================= AGG3 ================= -->

                                <Grid Grid.Row="4">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>

                                    <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Agg3"
                       Style="{DynamicResource SiteLabelStyle}"/>

                                    <TextBox Grid.Column="2"
                     Height="40"
                                             Margin="0,0,12,0"
                     Text="{Binding txtAgg3, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource SiteTextBoxStyle}"/>


                                    <TextBlock Grid.Column="3"
         Text="sec"
         VerticalAlignment="Center"
         Style="{DynamicResource SiteLabelStyle}"/>


                                </Grid>

                            </Grid>

                            <!-- ================= DIVIDER ================= -->

                            <Border Grid.Column="1"
            Width="1"
            Margin="6,0"
            Background="#E8ECF0"/>

                            <!-- ================= RIGHT PANEL ================= -->

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="8"/>

                                    <RowDefinition Height="54"/>

                                </Grid.RowDefinitions>

                                <!-- ================= AGG4 ================= -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform">
                                                    <VisualBrush.Visual>

                                                        <svgc:SvgViewbox Source="/Icons/Aggregate.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Rectangle.OpacityMask>

                                        </Rectangle>


                                    </Border>

                                    <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Text="Agg4"
               Style="{DynamicResource SiteLabelStyle}"/>

                                    <TextBox Grid.Column="2"
             Height="40" Margin="0,0,12,0"
             Text="{Binding txtAgg4, UpdateSourceTrigger=PropertyChanged}"
             Style="{DynamicResource SiteTextBoxStyle}"/>


                                    <TextBlock Grid.Column="3"
         Text="sec"
         VerticalAlignment="Center"
         Style="{DynamicResource SiteLabelStyle}"/>

                                </Grid>

                                <Border Grid.Row="0"
        VerticalAlignment="Bottom"
        Height="1"
        Background="#E7EBEF"/>

                                <!-- ================= AGG5 ================= -->

