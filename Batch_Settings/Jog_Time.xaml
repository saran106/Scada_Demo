                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Cem2"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding CemJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Cem3"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding CemJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Cem4"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding CemJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Cem5"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding CemJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                        </Grid>

                    </GroupBox>

                </Grid>


                <!-- ================= WATER ================= -->
                <Grid Visibility="{Binding WaterVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= JOG ON ================= -->
                    <GroupBox Grid.Column="0"
              Header="Jog ON"
              FontWeight="Bold"
              Padding="10">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Wtr1 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Wtr1"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding WaterJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Wtr2 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Wtr2"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         IsEnabled="False"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Wtr3 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="Wtr3"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         IsEnabled="False"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                        </Grid>

                    </GroupBox>

                    <!-- ================= JOG OFF ================= -->
                    <GroupBox Grid.Column="2"
              Header="Jog OFF"
              FontWeight="Bold"
              Padding="10">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Wtr1 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Wtr1"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding WaterJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Wtr2 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Wtr2"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         IsEnabled="False"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Wtr3 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="Wtr3"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         IsEnabled="False"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                        </Grid>

                    </GroupBox>

                </Grid>



                <!-- ================= ADMIX ================= -->
                <Grid Visibility="{Binding AdmixVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= JOG ON ================= -->
