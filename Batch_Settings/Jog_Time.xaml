                    </GroupBox>

                    <!-- ================= JOG OFF ================= -->
                    <GroupBox Grid.Column="2"
              Header="Jog OFF"
              FontWeight="Bold"
              Padding="10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
