<Window x:Class="Scada_Demo.Batch_Settings.Jog_Time"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jog Time"
        Height="490" Width="1330"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Jog time in terms of milliseconds"
                   Margin="5"
                   Style="{DynamicResource HeaderTextStyle}"/>

        <!-- TAB BUTTONS -->
        <StackPanel x:Name="TabButtons"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="5">

            <Button Content="Aggregate"
        Style="{DynamicResource TabButtonStyle}"
        Command="{Binding ShowAggregateCommand}"/>

            <Button Content="Cement"
        Style="{DynamicResource TabButtonStyle}"
        Command="{Binding ShowCementCommand}"/>

            <Button Content="Water"
        Style="{DynamicResource TabButtonStyle}"
        Command="{Binding ShowWaterCommand}"/>

            <Button Content="Admixture"
        Style="{DynamicResource TabButtonStyle}"
        Command="{Binding ShowAdmixCommand}"/>

            <Button Content="Micro Silica"
        Style="{DynamicResource TabButtonStyle}"
        Command="{Binding ShowSilicaCommand}"/>
        </StackPanel>

        <!-- CONTENT -->
        <Border Grid.Row="2"
                Margin="5"
                Padding="20"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <!-- ================= AGGREGATE ================= -->
                <Grid Visibility="{Binding AggregateVisibility}" Margin="10">

                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= JOG ON ================= -->
                        <GroupBox Grid.Column="0"
                  Header="Jog ON"
                  FontWeight="Bold"
                  Padding="10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Agg1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg1"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg1JogOn, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg2 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg2"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg2JogOn, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg3 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg3"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg3JogOn, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg4 -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg4"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg4JogOn, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg5 -->
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg5"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             IsEnabled="False"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg6 -->
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg6"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             IsEnabled="False"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                            </Grid>

                        </GroupBox>

                        <!-- ================= JOG OFF ================= -->
                        <GroupBox Grid.Column="2"
                  Header="Jog OFF"
                  FontWeight="Bold"
                  Padding="10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Agg1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg1"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg1JogOff, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg2 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg2"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg2JogOff, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg3 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Agg3"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg3JogOff, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg4 -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg4"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             Text="{Binding Agg4JogOff, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg5 -->
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg5"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             IsEnabled="False"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                                <!-- Agg6 -->
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Agg6"
                               Width="70"
                               Style="{DynamicResource CompactLabel}"/>
                                    <TextBox Width="180"
                             Height="34"
                             IsEnabled="False"
                             Style="{DynamicResource JogTextBoxStyle}"/>
                                </StackPanel>

                            </Grid>

                        </GroupBox>

                    </Grid>

                </Grid>
                <!-- ================= CEMENT ================= -->
                <Grid Visibility="{Binding CementVisibility}" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= JOG ON ================= -->
                    <GroupBox Grid.Column="0"
              Header="Jog ON"
              FontWeight="Bold"
              Padding="10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
