              Header="Jog ON"
              FontWeight="Bold"
              Padding="10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Admix1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Admix1"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding AdmixJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Admix2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Admix2"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
                         Height="34"
                         Text="{Binding AdmixJogOn, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource JogTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Admix3 -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Admix3"
                           Width="70"
                           Style="{DynamicResource CompactLabel}"/>
                                <TextBox Width="180"
