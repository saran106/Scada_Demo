        <!-- BUTTONS -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">
            <Button Content="Read from PLC"
        Width="130"
        Command="{Binding ReadFromPlcCommand}"/>

            <Button Content="Write to PLC / DB"
        Width="160"
        Command="{Binding WriteToPlcCommand}"/>

            <Button Content="Exit"
        Width="100"
        Style="{DynamicResource RedButton}"
        Command="{Binding ExitCommand}"/>
        </StackPanel>

    </Grid>
</Window>