<Window x:Class="Scada_Demo.Batch_Settings.Gate_Sequence"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC460 Gate Sequence Settings"
        
        Width="650"
        Height="380"
        
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        
        Background="{DynamicResource PrimaryBgBrush}">

    <Border Margin="10"
            BorderBrush="{DynamicResource BorderBrushColor}"
            BorderThickness="2"
            CornerRadius="8"
            Background="{DynamicResource PanelBrush}">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Current Gate Sequence"
                           Style="{DynamicResource HeaderTextStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="Preferred Gate Sequence"
                           Style="{DynamicResource HeaderTextStyle}"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- LEFT LIST -->
                <StackPanel>
                    <ListBox
    Height="250"
    Background="White"
    Foreground="Black"
    ItemsSource="{Binding CurrentItems}"
    SelectedItem="{Binding SelectedCurrentItem}" />
                </StackPanel>

                <!-- MIDDLE BUTTONS -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Button Content="&gt;"
        Width="50"
        Height="40"
        Command="{Binding MoveCommand}"/>

                    <Button Content="Refresh"
        Width="80"
        Height="40"
        Margin="0,20,0,0"
      Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <!-- RIGHT LIST -->
                <StackPanel Grid.Column="2">
                    <ListBox
    Height="250"
    Background="White"
    Foreground="Black"
    ItemsSource="{Binding PreferredItems}" />
                </StackPanel>

            </Grid>

            <!-- BOTTOM BUTTONS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">

                <Button Content="Read from PLC" Width="140" Command="{Binding ReadFromPlcCommand}"/>
                <Button Content="Write to PLC / DB"
        Width="170"
   Command="{Binding WriteToPlcCommand}"/>
                <Button Content="Exit"
        Width="120"
        Style="{DynamicResource RedButton}"
        Command="{Binding ExitCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>