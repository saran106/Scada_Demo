<Window x:Class="Scada_Demo.Transactions.Manual_Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MCI460 Manual Operation"
        Height="650"
        Width="1200"    
        Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBgBrush}">

    <Window.Resources>

        <Style x:Key="LampRedButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Grid Width="{TemplateBinding Width}"
                      Height="{TemplateBinding Height}">

                            <Viewbox Stretch="Fill">

                                <Path Fill="#FF2B2B"
                              Stroke="#FF9A9A"
                              StrokeThickness="1.5">

                                    <Path.Data>

                                        <PathGeometry>

                                            <PathFigure StartPoint="8,4" IsClosed="True">

                                                <!-- TOP -->
                                                <QuadraticBezierSegment
                                            Point1="29,-4"
                                            Point2="50,4"/>

                                                <!-- RIGHT TOP -->
                                                <QuadraticBezierSegment
                                            Point1="58,8"
                                            Point2="58,18"/>

                                                <!-- RIGHT SIDE -->
                                                <QuadraticBezierSegment
                                            Point1="58.5,24"
                                            Point2="58,30"/>

                                                <!-- RIGHT BOTTOM -->
                                                <QuadraticBezierSegment
                                            Point1="58,42"
                                            Point2="50,44"/>

                                                <!-- BOTTOM -->
                                                <QuadraticBezierSegment
                                            Point1="29,52"
                                            Point2="8,44"/>

                                                <!-- LEFT BOTTOM -->
                                                <QuadraticBezierSegment
                                            Point1="0,42"
                                            Point2="0,30"/>

                                                <!-- LEFT SIDE -->
                                                <QuadraticBezierSegment
                                            Point1="-0.5,24"
                                            Point2="0,18"/>

                                                <!-- LEFT TOP -->
                                                <QuadraticBezierSegment
                                            Point1="0,8"
                                            Point2="8,4"/>

                                            </PathFigure>

                                        </PathGeometry>

                                    </Path.Data>

                                </Path>

                            </Viewbox>

                            <!-- Reflection -->
                            <Border Width="10"
                            Height="4"
                            CornerRadius="2"
                            Background="White"
                            Opacity="0.8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0"/>

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RecognizesAccessKey="True"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96"
                                                ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

