<Window x:Class="Scada_Demo.Transactions.Manual_Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MCI460 Manual Operation"
        Height="600"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBgBrush}">

    <Window.Resources>

        <!-- GREEN LAMP -->
        <Style x:Key="LampGreen" TargetType="Ellipse">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Fill" Value="#7CFF00"/>
            <Setter Property="Stroke" Value="#C6FF66"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- RED LAMP -->
        <Style x:Key="LampRed" TargetType="Ellipse">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Fill" Value="#FF3131"/>
            <Setter Property="Stroke" Value="#FF7A7A"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- WHITE PIPE -->
        <Style x:Key="PipeStyle" TargetType="Line">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="3"/>
        </Style>

        <!-- TEXT -->
        <Style x:Key="WhiteText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Border Background="#0F0F0F"
                BorderBrush="#D0D0D0"
                BorderThickness="2"
                CornerRadius="5"
                Padding="15">

            <Canvas>

                <!-- ================================================= -->
                <!-- CEMENT FILLER -->
                <!-- ================================================= -->

                <Border Width="250"
                        Height="145"
                        Canvas.Left="25"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <!-- TOP -->
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="10" Canvas.Top="10"/>
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="90" Canvas.Top="10"/>
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="170" Canvas.Top="10"/>

                        <!-- BOTTOM -->
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="10" Canvas.Top="82"/>
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="90" Canvas.Top="82"/>
                        <Ellipse Style="{StaticResource LampGreen}" Canvas.Left="170" Canvas.Top="82"/>

                        <TextBlock Text="1" Canvas.Left="34" Canvas.Top="16"
                                   FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="2" Canvas.Left="114" Canvas.Top="16"
                                   FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="3" Canvas.Left="194" Canvas.Top="16"
                                   FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="4" Canvas.Left="34" Canvas.Top="88"
                                   FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="5" Canvas.Left="114" Canvas.Top="88"
                                   FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="CEMENT / FILLER"
                                   Style="{StaticResource WhiteText}"
                                   Canvas.Left="48"
                                   Canvas.Top="58"/>

                    </Canvas>

                </Border>

                <!-- ================================================= -->
                <!-- WATER -->
                <!-- ================================================= -->

                <Border Width="90"
                        Height="145"
                        Canvas.Left="300"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <Line X1="0" Y1="0"
                              X2="90" Y2="145"
                              Style="{StaticResource PipeStyle}"/>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="10"/>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="82"/>

                        <TextBlock Text="S.WATER"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="13"
                                   Canvas.Left="37"
                                   Canvas.Top="49"/>

                        <TextBlock Text="F.WATER"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="13"
                                   Canvas.Left="10"
                                   Canvas.Top="122"/>

                    </Canvas>

                </Border>

                <!-- ICE -->
                <Border Width="75"
                        Height="145"
                        Canvas.Left="405"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="8"
                                 Canvas.Top="12"/>

                        <TextBlock Text="1"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Canvas.Left="32"
                                   Canvas.Top="16"/>

                        <TextBlock Text="ICE"
                                   Style="{StaticResource WhiteText}"
                                   Canvas.Left="18"
                                   Canvas.Top="82"/>

                    </Canvas>

                </Border>

                <!-- ADMIX-1 -->
                <Border Width="90"
                        Height="145"
                        Canvas.Left="495"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="10"/>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="82"/>

                        <TextBlock Text="1"
                                   Canvas.Left="38"
                                   Canvas.Top="16"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="2"
                                   Canvas.Left="38"
                                   Canvas.Top="88"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ADMIX-1"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="13"
                                   Canvas.Left="8"
                                   Canvas.Top="54"/>

                    </Canvas>

                </Border>

                <!-- ADMIX-2 -->
                <Border Width="90"
                        Height="145"
                        Canvas.Left="595"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="10"/>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="82"/>

                        <TextBlock Text="1"
                                   Canvas.Left="38"
                                   Canvas.Top="16"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="2"
                                   Canvas.Left="38"
                                   Canvas.Top="88"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ADMIX-2"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="13"
                                   Canvas.Left="8"
                                   Canvas.Top="54"/>

                    </Canvas>

                </Border>

                <!-- SILICA -->
                <Border Width="90"
                        Height="145"
                        Canvas.Left="695"
                        Canvas.Top="20"
                        BorderBrush="White"
                        BorderThickness="2">

                    <Canvas>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="15"
                                 Canvas.Top="10"/>

                        <TextBlock Text="SILICA"
                                   Style="{StaticResource WhiteText}"
                                   Canvas.Left="15"
                                   Canvas.Top="82"/>

                    </Canvas>

                </Border>

                <!-- RIGHT STATUS -->
                <StackPanel Canvas.Left="820"
                            Canvas.Top="18">

                    <Ellipse Style="{StaticResource LampGreen}" Margin="0,0,0,12"/>
                    <Ellipse Style="{StaticResource LampGreen}" Margin="0,0,0,12"/>
                    <Ellipse Style="{StaticResource LampGreen}"/>

                </StackPanel>

                <!-- LOGO -->
                <Border Width="210"
                        Height="95"
                        Background="White"
                        Canvas.Left="930"
                        Canvas.Top="20">

                    <TextBlock Text="SCHWING&#10;Stetter"
                               Foreground="Black"
                               FontSize="30"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- ================================================= -->
                <!-- PIPELINES -->
                <!-- ================================================= -->

                <Line X1="330" Y1="230"
                      X2="900" Y2="230"
                      Style="{StaticResource PipeStyle}"/>

                <Line X1="330" Y1="230"
                      X2="330" Y2="190"
                      Style="{StaticResource PipeStyle}"/>

                <Line X1="430" Y1="230"
                      X2="430" Y2="190"
                      Style="{StaticResource PipeStyle}"/>

                <Line X1="530" Y1="230"
                      X2="530" Y2="190"
                      Style="{StaticResource PipeStyle}"/>

                <Line X1="630" Y1="230"
                      X2="630" Y2="190"
                      Style="{StaticResource PipeStyle}"/>

                <Line X1="730" Y1="230"
                      X2="730" Y2="190"
                      Style="{StaticResource PipeStyle}"/>

                <!-- ================================================= -->
                <!-- MIXER -->
                <!-- ================================================= -->

                <Border Width="250"
                        Height="210"
                        Canvas.Left="35"
                        Canvas.Top="290"
                        BorderBrush="White"
                        BorderThickness="3">

                    <Canvas>

                        <Ellipse Style="{StaticResource LampGreen}"
                                 Canvas.Left="10"
                                 Canvas.Top="10"/>

                        <Ellipse Width="58"
                                 Height="34"
                                 Fill="#D91E1E"
                                 Stroke="#FF7A7A"
                                 StrokeThickness="2"
                                 Canvas.Left="175"
                                 Canvas.Top="10"/>

                        <TextBlock Text="M-ON"
                                   FontWeight="Bold"
                                   Canvas.Left="24"
                                   Canvas.Top="16"/>

                        <TextBlock Text="M-OFF"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   Canvas.Left="187"
                                   Canvas.Top="16"/>

                        <TextBlock Text="MIXER"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="20"
                                   Canvas.Left="88"
                                   Canvas.Top="82"/>

                        <TextBlock Text="M.TIME"
                                   Style="{StaticResource WhiteText}"
                                   FontSize="14"
                                   Canvas.Left="84"
                                   Canvas.Top="110"/>

                        <Ellipse Width="75"
                                 Height="75"
                                 Stroke="#7CFF00"
                                 StrokeThickness="4"
                                 Canvas.Left="85"
                                 Canvas.Top="125"/>

                    </Canvas>

                </Border>

                <!-- ================================================= -->
                <!-- BIN SECTION -->
                <!-- ================================================= -->

                <ItemsControl Canvas.Left="421"
                              Canvas.Top="258">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Items>
                        <sys:String>BIN-1</sys:String>
                        <sys:String>BIN-2</sys:String>
                        <sys:String>BIN-3</sys:String>
                        <sys:String>BIN-4</sys:String>
                        <sys:String>BIN-5</sys:String>
                        <sys:String>BIN-6</sys:String>
                    </ItemsControl.Items>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="8">

                                <Border Width="95"
                                        Height="190"
                                        BorderBrush="White"
                                        BorderThickness="2">

                                    <Canvas>

                                        <Ellipse Style="{StaticResource LampGreen}"
                                                 Canvas.Left="18"
                                                 Canvas.Top="10"/>

                                        <TextBlock Text="C"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Canvas.Left="42"
                                                   Canvas.Top="16"/>

                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource WhiteText}"
                                                   FontSize="14"
                                                   Canvas.Left="16"
                                                   Canvas.Top="62"/>

                                        <Ellipse Style="{StaticResource LampGreen}"
                                                 Canvas.Left="18"
                                                 Canvas.Top="82"/>

                                        <TextBlock Text="F"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Canvas.Left="42"
                                                   Canvas.Top="88"/>

                                        <Border Width="70"
                                                Height="28"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                Canvas.Left="12"
                                                Canvas.Top="142">

                                            <TextBlock Text="G-OPEN"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>

                                    </Canvas>

                                </Border>

                                <Ellipse Width="70"
                                         Height="40"
                                         Stroke="#7CFF00"
                                         StrokeThickness="3"
                                         Margin="10"/>

                            </StackPanel>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Canvas>

        </Border>

    </Grid>

</Window>