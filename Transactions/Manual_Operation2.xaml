        <Style x:Key="BlinkingLampStyle" TargetType="Ellipse">

            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="#FF2B2B"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Red"
                              BlurRadius="12"
                              ShadowDepth="0"
                              Opacity="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever"
                            AutoReverse="True">

                            <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.2"
                        Duration="0:0:0.5"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>

        </Style>

