    <Window.Resources>

        <Style x:Key="LampRedButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#FF2B2B"/>
            <Setter Property="BorderBrush" Value="#FF9A9A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0">

                            <Grid>

                                <!-- Reflection -->
                                <Border Width="20"
                                Height="4"
                                CornerRadius="2"
                                Background="White"
                                Opacity="0.7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0"/>

                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.96"
                                    ScaleY="0.96"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="LampGreenButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#8CFF9E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0">

                            <Grid>

                                <!-- Reflection -->
                                <Border Width="20"
                                Height="4"
                                CornerRadius="2"
                                Background="White"
                                Opacity="0.7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0"/>

                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.96"
                                    ScaleY="0.96"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- GREEN LAMP -->
        <Style x:Key="LampGreen" TargetType="Ellipse">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Fill" Value="#7CFF00"/>
            <Setter Property="Stroke" Value="#C6FF66"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- RED LAMP -->
        <Style x:Key="LampRed" TargetType="Ellipse">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Fill" Value="#FF3131"/>
            <Setter Property="Stroke" Value="#FF7A7A"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- WHITE PIPE -->
        <Style x:Key="PipeStyle" TargetType="Line">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="3"/>
        </Style>

        <!-- TEXT -->
        <Style x:Key="WhiteText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>


        <Style x:Key="BlinkingLampStyle" TargetType="Ellipse">

            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="#FF2B2B"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Red"
                              BlurRadius="12"
                              ShadowDepth="0"
                              Opacity="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever"
                            AutoReverse="True">

                            <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.2"
                        Duration="0:0:0.5"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

