<Window x:Class="Scada_Demo.Transactions.Cement_Silo_Level"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Transactions"
        mc:Ignorable="d"
        Title="Cement Silo Level"
        Height="720"
        Width="1100"
        Background="{StaticResource PrimaryBgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <TextBlock Text="Cement Silo Level"
                           FontSize="30"
                           FontWeight="Bold"
                          
                          
                           Margin="0,0,0,20"/>

                <!-- SILO SECTION -->
                <UniformGrid Grid.Row="1"
                             Columns="5"
                             Margin="10">

                    <!-- REPEAT THIS STACKPANEL FOR ALL -->
                    <StackPanel HorizontalAlignment="Center">

                        <!-- TOP PERCENT -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">

                            <Border Width="120"
                                    Height="42"
                                    Background="#39FF14"
                                    BorderBrush="#A0FFA0"
                                    BorderThickness="2">

                                <TextBlock Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- SILO -->
                        <Grid Height="380"
                              Width="95">

                            <!-- OUTER -->
                            <Border Background="#8C8C8C"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="2"
                                    CornerRadius="2"/>

                            <!-- INNER WHITE -->
                            <Border Width="16"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="18,10,0,10"/>

                            <!-- SCALE -->
                            <Rectangle Width="4"
                                       Fill="#EFEFEF"
                                       HorizontalAlignment="Center"
                                       Margin="0,15"/>

                            <!-- BLUE INDICATOR -->
                            <Border Width="28"
                                    Height="16"
                                    Background="#0094FF"
                                    CornerRadius="8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Margin="6,0,0,8"/>

                            <!-- TOP -->
                            <TextBlock Text="100"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                     
                                       Margin="-40,5,0,0"
                                       VerticalAlignment="Top"/>

                            <!-- BOTTOM -->
                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-15,0,0,5"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                        <!-- LABEL -->
                        <TextBlock Text="CEM1"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                 
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CEM2 -->
                    <StackPanel HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">

                            <Border Width="120"
                                    Height="42"
                                    Background="#39FF14"
                                    BorderBrush="#A0FFA0"
                                    BorderThickness="2">

                                <TextBlock Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Height="380"
                              Width="95">

                            <Border Background="#8C8C8C"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="2"/>

                            <Border Width="16"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="18,10,0,10"/>

                            <Rectangle Width="4"
                                       Fill="#EFEFEF"
                                       HorizontalAlignment="Center"
                                       Margin="0,15"/>

                            <Border Width="28"
                                    Height="16"
                                    Background="#0094FF"
                                    CornerRadius="8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Margin="6,0,0,8"/>

                            <TextBlock Text="100"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-40,5,0,0"
                                       VerticalAlignment="Top"/>

                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                          Margin="-15,0,0,5"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                        <TextBlock Text="CEM2"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                 
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CEM3 -->
                    <StackPanel HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">

                            <Border Width="120"
                                    Height="42"
                                    Background="#39FF14"
                                    BorderBrush="#A0FFA0"
                                    BorderThickness="2">

                                <TextBlock Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Height="380"
                              Width="95">

                            <Border Background="#8C8C8C"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="2"/>

                            <Border Width="16"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="18,10,0,10"/>

                            <Rectangle Width="4"
                                       Fill="#EFEFEF"
                                       HorizontalAlignment="Center"
                                       Margin="0,15"/>

                            <Border Width="28"
                                    Height="16"
                                    Background="#0094FF"
                                    CornerRadius="8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Margin="6,0,0,8"/>

                            <TextBlock Text="100"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-40,5,0,0"
                                       VerticalAlignment="Top"/>

                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-15,0,0,5"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                        <TextBlock Text="CEM3"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CEM4 -->
                    <StackPanel HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">

                            <Border Width="120"
                                    Height="42"
                                    Background="#39FF14"
                                    BorderBrush="#A0FFA0"
                                    BorderThickness="2">

                                <TextBlock Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Height="380"
                              Width="95">

                            <Border Background="#8C8C8C"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="2"/>

                            <Border Width="16"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="18,10,0,10"/>

                            <Rectangle Width="4"
                                       Fill="#EFEFEF"
                                       HorizontalAlignment="Center"
                                       Margin="0,15"/>

                            <Border Width="28"
                                    Height="16"
                                    Background="#0094FF"
                                    CornerRadius="8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Margin="6,0,0,8"/>

                            <TextBlock Text="100"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-40,5,0,0"
                                       VerticalAlignment="Top"/>

                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                      
                                       Margin="-15,0,0,5"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                        <TextBlock Text="CEM4"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CEM5 -->
                    <StackPanel HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">

                            <Border Width="120"
                                    Height="42"
                                    Background="#39FF14"
                                    BorderBrush="#A0FFA0"
                                    BorderThickness="2">

                                <TextBlock Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Height="380"
                              Width="95">

                            <Border Background="#8C8C8C"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="2"/>

                            <Border Width="16"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="18,10,0,10"/>

                            <Rectangle Width="4"
                                       Fill="#EFEFEF"
                                       HorizontalAlignment="Center"
                                       Margin="0,15"/>

                            <Border Width="28"
                                    Height="16"
                                    Background="#0094FF"
                                    CornerRadius="8"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    Margin="6,0,0,8"/>

                            <TextBlock Text="100"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                    
                                       Margin="-40,5,0,0"
                                       VerticalAlignment="Top"/>

                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                     
                                       Margin="-15,0,0,5"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                        <TextBlock Text="CEM5"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                  
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </UniformGrid>

                <!-- BUTTON -->
                <Button Grid.Row="2"
                        Content="EXIT"
                        Width="180"
                        Height="34"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Style="{StaticResource RedButton}"/>

            </Grid>

        </Border>

    </Grid>

</Window>


