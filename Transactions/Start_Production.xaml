<Window x:Class="Scada_Demo.Transactions.Start_Production"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:Scada_Demo.Calibration"
mc:Ignorable="d"
        Title="MCI460 Start Batch Transaction"
            Icon="../project_small_i.png"
        Height="790"
        Width="1200"
Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">

        <!-- ===================================================== -->
        <!-- MAIN ROWS -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="Auto"/>

            <!-- MAIN -->
            <RowDefinition Height="*"/>

            <!-- BUTTON -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
      Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ICON -->
            <Border Grid.Column="0"
            Width="42"
            Height="42"
            VerticalAlignment="Center"
            Style="{DynamicResource SiteIconBoxStyle}">

                <Image Source="/Icons/Product_Name.png"
               Width="24"
               Height="24"
               Stretch="Uniform"/>

            </Border>

            <!-- TITLE -->
            <TextBlock Grid.Column="1"
               Text="Start Production"
               Margin="14,0,0,0"
               VerticalAlignment="Center"
               Style="{DynamicResource SiteHeaderStyle}"/>

            <!-- STATUS -->
            <Border Grid.Column="2"
            Background="{DynamicResource SiteAccentBrush}"
            CornerRadius="12"
            Padding="12,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

                <TextBlock Text="PRODUCTION"
                   Foreground="White"
                   FontSize="11"
                   FontWeight="Bold"
                   Margin="0"/>

            </Border>

            <!-- LINE + DOT -->
            <Grid Grid.ColumnSpan="3"
          VerticalAlignment="Bottom"
          Margin="0,0,0,-5">

                <Border Height="1.5"
                Background="{DynamicResource SiteAccentBrush}"/>

                <Ellipse Width="10"
                 Height="10"
                 Fill="{DynamicResource SiteAccentBrush}"
                 HorizontalAlignment="Right"/>

            </Grid>

        </Grid>

        <!-- ===================================================== -->
        <!-- MAIN BORDER -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
        Margin="0,0,0,12"
        Padding="14"
        Style="{DynamicResource SiteOuterBorderStyle}">

            <Grid>

                <!-- MAIN 2 ROWS -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TOP SECTION -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <!-- RESPONSIVE COLUMNS -->
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ============================================= -->
                    <!-- LEFT -->
                    <!-- ============================================= -->

                    <Border Grid.Column="0"
        Padding="16"
        Style="{DynamicResource SiteOuterBorderStyle}">

                        <Grid Margin="0,0,15,0">
                            <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                            
                            
                            
                        <!-- SCHEDULE -->

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock Text="Schedule ID"
                       Style="{StaticResource CompactLabel}"
                       VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1"
          Height="38"
          MinWidth="280"
                                          IsEditable="True"
          Style="{DynamicResource SiteComboBoxStyle}"
          ItemsSource="{Binding ScheduleIds}"
          SelectedItem="{Binding SelectedScheduleId}"/>

                            </Grid>


                        <!-- AVAILABLE ORDER -->

                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock Text="Available order"
                       Style="{StaticResource CompactLabel}"
                       VerticalAlignment="Top"/>

                                <Border Grid.Column="1"
        Height="130"
        VerticalAlignment="Top"
        Margin="0,18,0,0"
        Background="White"
        BorderBrush="#DDE3E8"
        BorderThickness="1"
        CornerRadius="8">

                                    <ListBox
        Background="Transparent"
        BorderThickness="0"
        Foreground="#1F2937"
        Padding="4"
        ItemsSource="{Binding OrderIds}"
        SelectedItem="{Binding SelectedOrderId, Mode=TwoWay}"/>

                                </Border>

                            </Grid>

                        </Grid>
                    </Border>


                    <!-- ============================================= -->
                    <!-- RIGHT -->
                    <!-- ============================================= -->

                    <Border Grid.Column="2"
        Padding="16"
        Style="{DynamicResource SiteOuterBorderStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>
                                <RowDefinition Height="1"/>

                                <RowDefinition Height="40"/>

                            </Grid.RowDefinitions>


                            <!-- ================================================= -->
                            <!-- CUSTOMER ID -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="0"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Customer_ID2.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Customer ID"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Text="{Binding CustomerID}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="1"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- SITE -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="2"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Site.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Site"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Text="{Binding Site}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="3"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- RECIPE ID -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="4"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Product_Name.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Recipe ID"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Text="{Binding RecipeID}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="5"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- RECIPE NAME -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="6"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Product_Name.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Recipe Name"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Text="{Binding RecipeName}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="7"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>

                            <!-- ================================================= -->
                            <!-- TRUCK NO -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="8"
      Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
            Width="32"
            Height="32"
            Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/mixer-truck.png"
               Width="22"
               Height="22"
               Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
               Text="Truck No"
               VerticalAlignment="Center"
               Style="{DynamicResource SiteLabelStyle}"/>

                                <ComboBox Grid.Column="3"
              Height="32"
              Width="150"
              IsEditable="True"
              ItemsSource="{Binding TruckNos}"
              SelectedItem="{Binding SelectedTruckNo}"
              Style="{DynamicResource SiteComboBoxStyle}"
              HorizontalAlignment="Left"
              Margin="0,4"/>

                            </Grid>

                            <Border Grid.Row="9"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- DRIVER -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="10"
      Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
            Width="32"
            Height="32"
            Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Contact.png"
               Width="22"
               Height="22"
               Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
               Text="Driver"
               VerticalAlignment="Center"
               Style="{DynamicResource SiteLabelStyle}"/>

                                <ComboBox Grid.Column="3"
              Height="32"
              Width="150"
              IsEditable="True"
              ItemsSource="{Binding Drivers}"
              SelectedItem="{Binding SelectedDriver}"
              Style="{DynamicResource SiteComboBoxStyle}"
              HorizontalAlignment="Left"
              Margin="0,4"/>

                            </Grid>

                            <Border Grid.Row="11"
        Grid.ColumnSpan="4"
        Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- PRODUCTION QTY -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="12"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Quantity.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Production Qty"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Margin="0,4"
                 Text="{Binding ProductionQty}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="13"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- RETURNED QTY -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="14"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Quantity.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Returned Qty"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Margin="0,4"
                 Text="{Binding ReturnedQty}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="15"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- MIXER CAPACITY -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="16"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/mixer-truck.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Mixer Capacity"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Margin="0,4"
                 Text="{Binding MixerCapacity}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="17"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- MIXING TIME -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="18"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/calendar.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Mixing Time"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Margin="0,4"
                 Text="{Binding MixingTime}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                            <Border Grid.Row="19"
            Grid.ColumnSpan="4"
            Background="#ECEFF3"/>


                            <!-- ================================================= -->
                            <!-- SLURRY SPLIT -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="20"
          Grid.ColumnSpan="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                Width="32"
                Height="32"
                Style="{DynamicResource SiteIconBoxStyle}">

                                    <Image Source="/Icons/Quantity.png"
                   Width="22"
                   Height="22"
                   Stretch="Uniform"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                   Text="Slurry Split in %"
                   VerticalAlignment="Center"
                   Style="{DynamicResource SiteLabelStyle}"/>

                                <TextBox Grid.Column="3"
                 Height="32"
                 Margin="0,4"
                 Text="{Binding SlurrySplit}"
                 Style="{DynamicResource SiteTextBoxStyle}"/>

                            </Grid>

                        </Grid>
                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- PROD SECTION -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
              Margin="0,25,0,0"
              MaxHeight="80"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                    <UniformGrid Columns="4">

                        <!-- PROD1 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod1"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD2 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod2"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD3 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod3"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD4 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod4"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD5 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod5"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD6 -->
