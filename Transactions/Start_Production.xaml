                    Margin="8">

                            <TextBlock Text="Prod6"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD7 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod7"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD8 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod8"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD9 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod9"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD10 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod10"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD11 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod11"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD12 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod12"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD13 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod13"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD14 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod14"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD15 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod15"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD16 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod16"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD17 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod17"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD18 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod18"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD19 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod19"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PROD20 -->
                        <StackPanel Orientation="Horizontal"
                    Margin="8">

                            <TextBlock Text="Prod20"
                       Width="50"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <TextBox Width="100"
                     Height="34"
                     Style="{DynamicResource SiteTextBoxStyle}"/>

                        </StackPanel>

                    </UniformGrid>

                </ScrollViewer>
            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- BUTTON SECTION -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,15,15">

            <TextBox Width="320"
                     Height="42"
                     Margin="0,0,15,0"
                     Style="{StaticResource JogTextBoxStyle}"/>

            <Button Content="Start"
                    Width="160"
                    Height="45"
                    Margin="0,0,15,0"/>

            <Button Content="eXit"
                    Width="160"
                    Height="45"
                    Style="{StaticResource RedButton}"/>

        </StackPanel>

    </Grid>

</Window>