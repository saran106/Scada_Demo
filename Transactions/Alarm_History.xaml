<Window x:Class="Scada_Demo.Transactions.Alarm_History"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm History"
        Height="570" Width="850"
ResizeMode="NoResize"
            Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
            Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Color="Black"
                              Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="20">

                <!-- ================= MAIN ROWS ================= -->

                <Grid.RowDefinitions>

                    <!-- HEADER -->

                    <RowDefinition Height="75"/>

                    <!-- TABLE -->

                    <RowDefinition Height="*"/>

                    <!-- BOTTOM -->

                    <RowDefinition Height="140"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0">

                    <!-- HEADER INTERNAL ROWS -->

                    <Grid.RowDefinitions>

                        <!-- TITLE ROW -->
                        <RowDefinition Height="55"/>

                        <!-- LINE ROW -->
                        <RowDefinition Height="20"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- TITLE AREA -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- HEADER ICON -->

                        <Border Grid.Column="0"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Address1.png"
                   Width="22"
                   Height="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"/>

                        </Border>


                        <!-- HEADER TITLE -->

                        <TextBlock Grid.Column="1"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Text="Alarm History"
                   Style="{DynamicResource SiteHeaderStyle}"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- GREEN LINE + ELLIPSE -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1"
          VerticalAlignment="Center">

                        <!-- GREEN LINE -->

                        <Border Height="1.5"
                Background="{DynamicResource SiteAccentBrush}"/>


                        <!-- RIGHT END ELLIPSE -->

                        <Ellipse Width="10"
                 Height="10"
                 Fill="{DynamicResource SiteAccentBrush}"
                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>



                <!-- ================= TABLE CARD ================= -->

                <Border Grid.Row="1"
        Margin="0,12,0,0"
        Padding="5"
        Style="{DynamicResource SiteOuterBorderStyle}">

                    <DataGrid x:Name="AlarmHistoryGrid"
          ItemsSource="{Binding AlarmRecords}"
          AutoGenerateColumns="False"
          Background="Transparent"
          Foreground="#1F2937"
          BorderThickness="0"
          RowHeight="36"
          ColumnHeaderStyle="{DynamicResource PremiumDataGridHeaderStyle}"
          CellStyle="{DynamicResource PremiumDataGridCellStyle}"
          RowStyle="{DynamicResource PremiumDataGridRowStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Alarm ID"
                            Binding="{Binding AlarmId}"
                            Width="100"/>

                            <DataGridTextColumn Header="Alarm Description"
                            Binding="{Binding Description}"
                            Width="2*"/>

                            <DataGridTextColumn Header="Alarm Date"
                            Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}"
                            Width="130"/>

                            <DataGridTextColumn Header="User"
                            Binding="{Binding User}"
                            Width="100"/>

                            <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="100"/>

                            <DataGridTextColumn Header="Acknowledge Date"
                            Binding="{Binding AckDate}"
                            Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


                <!-- ================= BOTTOM FILTER AREA ================= -->

                <Border Grid.Row="2"
        Margin="0,12,0,0"
        Background="#F8F9FB"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12"
        Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="52"/>

                            <RowDefinition Height="52"/>

                        </Grid.RowDefinitions>


                        <!-- ================= DATE ROW ================= -->

                        <Grid Grid.Row="0"
              HorizontalAlignment="Center">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="180"/>

                                <ColumnDefinition Width="35"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="180"/>

                            </Grid.ColumnDefinitions>


                            <!-- FROM DATE -->

                            <TextBlock Grid.Column="0"
                       Text="From Date"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Style="{DynamicResource SiteLabelStyle}"/>

                            <DatePicker x:Name="FromDatePicker"
            SelectedDate="{Binding FromDate, Mode=TwoWay}"
            Grid.Column="1"
            Width="180"
            Height="38"
            VerticalAlignment="Center"/>


                            <!-- GAP -->

                            <Border Grid.Column="2"/>


                            <!-- TO DATE -->

                            <TextBlock Grid.Column="3"
                       Text="To Date"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Style="{DynamicResource SiteLabelStyle}"/>


                            <DatePicker x:Name="ToDatePicker"
            SelectedDate="{Binding ToDate, Mode=TwoWay}"
            Grid.Column="4"
            Width="180"
            Height="38"
            VerticalAlignment="Center"/>

                        </Grid>


                        <!-- ================= BUTTON ROW ================= -->

                        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <!-- ================= VIEW ================= -->

                            <Button x:Name="ViewButton"
        Width="140"
        Height="42"
        Margin="0,0,15,0"
        Command="{Binding ViewCommand}"
        Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                    <Image Source="/Icons/city.png"
               Width="18"
               Height="18"
               Margin="0,0,8,0"/>

                                    <TextBlock Text="View"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                                </StackPanel>

                            </Button>


                            <!-- ================= EXIT ================= -->

                            <Button x:Name="ExitButton"
        Width="140"
        Height="42"
        Command="{Binding ExitCommand}"
        Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
               Width="18"
               Height="18"
               Margin="0,0,8,0"/>

                                    <TextBlock Text="Exit"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>
</Window>