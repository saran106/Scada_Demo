<Window x:Class="Scada_Demo.Transactions.Divert_Concrete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Divert_Concrete"
        Height="500" Width="600"
    
            Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
            Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Color="Black"
                              Opacity="0.12"/>

            </Border.Effect>

            <Grid Margin="25">

                <!-- ================= ROW DEFINITIONS ================= -->

                <Grid.RowDefinitions>

                    <RowDefinition Height="90"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                  Margin="0,-55,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="50"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- HEADER ICON -->

                    <Border Grid.Column="0"
                        Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/Pincode.png"
                           Width="24"
                           Height="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Border>

                    <!-- HEADER TITLE -->

                    <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Divert Concrete"
                           Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,35">

                        <Border Height="1.5"
                            Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="11"
                             Height="11"
                             Fill="{DynamicResource SiteAccentBrush}"
                             HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                  Margin="0,-20,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="52"/>
                        <RowDefinition Height="1"/>

                        <RowDefinition Height="95"/>

                    </Grid.RowDefinitions>



                    <!-- ================= BATCH NO ================= -->

                    <Grid Grid.Row="0"
                      Height="58">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="180"/>

                            <ColumnDefinition Width="25"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                            Height="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
                               Width="20"
                               Height="20"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Batch No"
                               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
                              Height="42"
                              VerticalAlignment="Center"
                              Style="{DynamicResource SiteComboBoxStyle}" IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="1"
                        Height="1"
                        Background="#ECEFF3"/>

                    <!-- ================= SUB BATCH NO ================= -->

                    <Grid Grid.Row="2"
                      Height="58">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="180"/>

                            <ColumnDefinition Width="25"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                            Height="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
                               Width="20"
                               Height="20"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Sub Batch No"
                               Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox Grid.Column="3"
                              Height="42"
                              VerticalAlignment="Center"
                              Style="{DynamicResource SiteComboBoxStyle}" IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="3"
                        Height="1"
                        Background="#ECEFF3"/>


                    <!-- ================= CUSTOMER ================= -->

                    <Grid Grid.Row="4"
                      Height="58">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="180"/>

                            <ColumnDefinition Width="25"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ICON -->

                        <Border Width="40"
                            Height="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
                               Width="20"
                               Height="20"/>

                        </Border>

                        <!-- LABEL -->

                        <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Customer"
                               Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- COMBO -->

                        <ComboBox Grid.Column="3"
                              Height="42"
                              VerticalAlignment="Center"
                              Style="{DynamicResource SiteComboBoxStyle}" IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="5"
                        Height="1"
                        Background="#ECEFF3"/>

                    <!-- ================= SITE ================= -->

                    <Grid Grid.Row="6"
                      Height="58">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="180"/>

                            <ColumnDefinition Width="25"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ICON -->

                        <Border Width="40"
                            Height="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Site.png"
                               Width="20"
                               Height="20"/>

                        </Border>

                        <!-- LABEL -->

                        <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Site"
                               Style="{DynamicResource SiteLabelStyle}"/>

                        <!-- COMBO -->

                        <ComboBox Grid.Column="3"
                              Height="42"
                              VerticalAlignment="Center"
                              Style="{DynamicResource SiteComboBoxStyle}"  IsEditable="True"/>

                    </Grid>

                    <Border Grid.Row="7"
                        Height="1"
                        Background="#ECEFF3"/>


                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="8"
                        Margin="-25,10,-25,-36"
                        Background="#F3F4F6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,1,1,0"
                        CornerRadius="0,0,18,18">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- ================= DIVERT ================= -->

                            <Button Grid.Column="1"
                                Height="46"
                                Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Image Source="/Icons/Pincode.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"/>

                                    <TextBlock Text="Divert"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- ================= EXIT ================= -->

                            <Button Grid.Column="3"
                                Height="46"
                                Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"/>

                                    <TextBlock Text="Exit"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>