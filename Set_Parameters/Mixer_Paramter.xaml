<Window x:Class="Scada_Demo.Set_Parameters.Mixer_Paramter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer_Paramter"
        Height="650"
        Width="670"
         Icon="../project_small_i.png"
        Background="{DynamicResource SitePageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/mixer-truck.png"
                               Width="26"
                               Height="26"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Mixer Settings"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.RowDefinitions>

                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>
                         <RowDefinition Height="54"/>

                        <!-- Footer -->
                        <RowDefinition Height="90"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- 1. MIXER DISCHARGE TIME -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Address.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mixer Discharge Time (Sec)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtDischargeTime"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="0"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 2. MID POSITION -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/calendar.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mixer Mid Position (%)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <ComboBox x:Name="cmbMidPosition"
                                  Grid.Column="3"
                                  Height="42"
                                  IsEditable="True"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource SiteComboBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 3. HOLD DELAY -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mid Position Hold Delay (Sec)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtHoldDelay"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="10"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 4. MIXING TIME -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="3" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mixer Mixing Time (Sec)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtMixingTime"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 5. PRE MIXING -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Delete.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Pre Mixing Time (Sec)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtPreMixTime"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="0"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 6. MIXER OFF DELAY TIME -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="5" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Pincode.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mixer OFF Delay Time (Sec)"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtOffDelayTime"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="1"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="5"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 7. MIXER RUNNING HOURS -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="6" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Distance.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mixer Running Hours"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtRunningHours"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="0"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="6"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="7"
        Margin="-22,8,-22,-30"
        CornerRadius="0,0,18,18"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        Background="#F3F4F6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- READ FROM PLC -->

                            <Button Grid.Column="1"
                                    Height="46"
                                    Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Read from PLC"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- WRITE TO PLC / DB -->

                            <Button Grid.Column="3"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Write PLC / DB"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button Grid.Column="5"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Exit"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>