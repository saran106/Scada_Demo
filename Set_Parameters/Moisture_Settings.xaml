<Window x:Class="Scada_Demo.Set_Parameters.Moisture_Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.Set_Parameters"
        mc:Ignorable="d"
        Title="Moisture_Settings"      ResizeMode="NoResize"    Height="540" Width="680"
        
        WindowStartupLocation="CenterScreen">

    <!--<Grid Margin="8">

        --><!-- MAIN ROWS --><!--
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            --><!-- Header --><!--
            <RowDefinition Height="Auto"/>
            --><!-- Content --><!--
            <RowDefinition Height="Auto"/>
            --><!-- Buttons --><!--
        </Grid.RowDefinitions>

        --><!-- ================= HEADER ================= --><!--
        <TextBlock Text="Mositure Settings"
                   Margin="10,5"
                   Style="{StaticResource HeaderTextStyle}"/>

        --><!-- ================= CONTENT ================= --><!--
        <Border Grid.Row="1"
                Margin="10"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="2"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    --><!-- Label --><!--
                    <ColumnDefinition Width="20"/>
                    --><!-- Gap --><!--
                    <ColumnDefinition Width="2*"/>
                    --><!-- Input --><!--
                </Grid.ColumnDefinitions>

                --><!-- 🔥 CHANGE HERE --><!--
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

               

                --><!-- 2 --><!--
                <TextBlock Text="Auto Moisture"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <ComboBox Grid.Row="1" Grid.Column="2"
          Height="34"
          Width="180"
          VerticalAlignment="Center"
          Margin="0,6"/>

             

               
                --><!-- 3 --><!--
                <TextBlock Text="Bin Configuration for first mositure"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="4" Grid.Column="2"
                         Style="{StaticResource JogTextBoxStyle}"
                         Height="34"
                         Text="0"/>

                --><!-- 4 --><!--
                <TextBlock Text="Bin Configuration for second mositure"
                           Grid.Row="5"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="5" Grid.Column="2"
                         Style="{StaticResource JogTextBoxStyle}"
                         Height="34"
                         Text="1"/>

                --><!-- 5 --><!--
                <TextBlock Text="Start weight for moisture calculation in kg"
                           Grid.Row="6"
                           VerticalAlignment="Center"
                           Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="6" Grid.Column="2"
                         Style="{StaticResource JogTextBoxStyle}"
                         Height="34"
                         IsReadOnly="True"
                         Text="0"/>

                --><!-- 6 --><!--
                <TextBlock Text="Stop weight for moisture calculation in kg"
            Grid.Row="3"
            VerticalAlignment="Center"
            Style="{StaticResource CompactLabel}"/>

                <TextBox Grid.Row="3" Grid.Column="2"
          Style="{StaticResource JogTextBoxStyle}"
          Height="34"/>


            </Grid>
        </Border>

        --><!-- ================= BUTTONS ================= --><!--
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="Read from PLC"
                    Width="150"
                    Margin="8"/>

            <Button Content="Write to PLC / DB"
                    Width="180"
                    Margin="8"/>

            <Button Content="Exit"
                    Width="110"
                    Margin="8"
                    Style="{StaticResource RedButton}"/>

        </StackPanel>

    </Grid>-->



    <Grid>

        <!-- ================= OUTER CARD ================= -->

        <Border Margin="12"
                Style="{DynamicResource SiteOuterBorderStyle}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,-45,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ICON -->

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            Style="{DynamicResource SiteIconBoxStyle}">

                        <Image Source="/Icons/mixer-truck.png"
                               Width="26"
                               Height="26"/>

                    </Border>

                    <!-- TITLE -->

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Mositure Settings"
                               Style="{DynamicResource SiteHeaderStyle}"/>

                    <!-- GREEN LINE -->

                    <Grid Grid.ColumnSpan="3"
                          Margin="0,0,0,25"
                          VerticalAlignment="Bottom">

                        <Border Height="1.5"
                                Background="{DynamicResource SiteAccentBrush}"/>

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource SiteAccentBrush}"
                                 HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>

                <!-- ================= FORM ================= -->

                <Grid Grid.Row="1"
                      Margin="0,-10,0,0">

                    <Grid.RowDefinitions>

                      
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                       

                        <!-- Footer -->
                        <RowDefinition Height="90"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- 1. MIXER DISCHARGE TIME -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Address.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Auto Moisture"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                   



                        <ComboBox x:Name="txtDischargeTime"
                                  Grid.Column="3"
                                  Height="42"
                                  IsEditable="True"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource SiteComboBoxStyle}"/>


                    </Grid>

                    <Border Grid.Row="0"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 2. MID POSITION -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/calendar.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Bin Configuration for first mositure"
                                   Style="{DynamicResource SiteLabelStyle}"/>



                        <TextBox x:Name="cmbMidPosition"
          Grid.Column="3"
          Height="42"
          VerticalAlignment="Center"
          Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 3. HOLD DELAY -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="2" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Customer_ID2.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Bin Configuration for second mositure"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtHoldDelay"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="10"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 4. MIXING TIME -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="3" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="305"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Contact.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Start weight for moisture calculation in kg"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtMixingTime"
                                 Grid.Column="3"
                                 Height="42"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                    <!-- ================================================= -->
                    <!-- 5. PRE MIXING -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4" Height="58">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="305"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource SiteIconBoxStyle}">

                            <Image Source="/Icons/Delete.png"
                                   Width="22"
                                   Height="22"/>

                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Stop weight for moisture calculation in kg"
                                   Style="{DynamicResource SiteLabelStyle}"/>

                        <TextBox x:Name="txtPreMixTime"
                                 Grid.Column="3"
                                 Height="42"
                                 Text="0"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource SiteTextBoxStyle}"/>

                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,50,0,0"
                            Height="1"
                            Background="#ECEFF3"/>

                   
                    <!-- ================================================= -->
                    <!-- 7. MIXER RUNNING HOURS -->
                    <!-- ================================================= -->


                    <!-- ================= FOOTER ================= -->

                    <Border Grid.Row="7"
        Margin="-22,8,-22,-30"
        CornerRadius="0,0,18,18"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        Background="#F3F4F6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- READ FROM PLC -->

                            <Button Grid.Column="1"
                                    Height="46"
                                    Style="{StaticResource SaveButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Read from PLC"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                </StackPanel>

                            </Button>

                            <!-- WRITE TO PLC / DB -->

                            <Button Grid.Column="3"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/save.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Write PLC / DB"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                            <!-- EXIT -->

                            <Button Grid.Column="5"
                                    Height="46"
                                    Style="{StaticResource WhiteActionButtonStyle}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Image Source="/Icons/exit.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Exit"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>
