<Window x:Class="Scada_Demo.User.Register_New_User"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register_New_User"
        Height="780" Width="1005"
      
        Background="{DynamicResource SitePageBackgroundBrush}"
            Icon="../project_small_i.png"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">

        <!-- 🔥 MAIN ROW STRUCTURE -->
        <Grid.RowDefinitions>
           
            <RowDefinition Height="*"/>
            <!-- CONTENT -->
            <RowDefinition Height="Auto"/>
            <!-- BUTTONS -->
        </Grid.RowDefinitions>

       

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="0">

            <!-- MAIN 2 COLUMNS -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDE ================= -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <RowDefinition Height="2.8*"/>
                </Grid.RowDefinitions>

                <!-- ================= USER PARAMETERS ================= -->

                <Border Grid.Row="0"
        Margin="0,0,12,12"
        Padding="22"
        Style="{DynamicResource SiteOuterBorderStyle}">

                    <Grid>

                        <!-- Columns -->
                        <Grid.ColumnDefinitions>

                            <!-- Label -->
                            <ColumnDefinition Width="170"/>

                            <!-- Gap -->
                            <ColumnDefinition Width="20"/>

                            <!-- Control -->
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- Rows -->

                        <Grid.RowDefinitions>

                            <RowDefinition Height="38"/>

                            <RowDefinition Height="40"/>

                            <RowDefinition Height="40"/>

                            <RowDefinition Height="40"/>

                            <RowDefinition Height="46"/>

                            <RowDefinition Height="30"/>

                        </Grid.RowDefinitions>

                        <!-- HEADER -->

                        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="User Parameters"
                   Style="{StaticResource SiteHeaderStyle}"
                   Margin="0,0,0,8"/>

                        <!-- USER NAME -->

                        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="User name"
                   VerticalAlignment="Center"
                   Style="{StaticResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="1"
                 Grid.Column="2"
                 Width="310"
                 Height="38"
                 HorizontalAlignment="Left"
                 Style="{StaticResource SiteTextBoxStyle}"
                 Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- PASSWORD -->

                        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Password"
                   VerticalAlignment="Center"
                   Style="{StaticResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="2"
                 Grid.Column="2"
                 Width="310"
                 Height="38"
                 HorizontalAlignment="Left"
                 Style="{StaticResource SiteTextBoxStyle}"
                 Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- CONFIRM PASSWORD -->

                        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Confirm password"
                   VerticalAlignment="Center"
                   Style="{StaticResource SiteLabelStyle}"/>

                        <TextBox Grid.Row="3"
                 Grid.Column="2"
                 Width="310"
                 Height="38"
                 HorizontalAlignment="Left"
                 Style="{StaticResource SiteTextBoxStyle}"
                 Text="{Binding ConfirmPassword,UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- AUTHORITY -->

                        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Authority level"
                   VerticalAlignment="Center"
                   Style="{StaticResource SiteLabelStyle}"/>

                        <ComboBox Grid.Row="4"
                  Grid.Column="2"
                  Width="310"
                  Height="38"
                  HorizontalAlignment="Left"
                  Style="{StaticResource SiteComboBoxStyles}"/>

                        <!-- SELECT ALL -->

                        <CheckBox Grid.Row="5"
                  Grid.ColumnSpan="3"
                  Margin="0,10,0,0"
                  VerticalAlignment="Center"
                  Content="Select (or) Deselect all options"
                  IsChecked="{Binding SelectAllPermissions}"/>

                    </Grid>

                </Border>

                <!-- MASTER + TRANSACTION -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MASTER -->
                    <Border Grid.Column="0"
        Margin="0,0,6,0"
        Padding="18"
        Style="{DynamicResource SiteOuterBorderStyle}">

                        <StackPanel>
                            <TextBlock Text="Master Segment"
           Style="{DynamicResource SiteHeaderStyle}"
           Margin="0,0,0,8"/>

                            <CheckBox Content="Customer"
              Margin="0.8"
              IsChecked="{Binding AuthMasCus}" />

                            <CheckBox Content="Site"
              Margin="0.8"
              IsChecked="{Binding AuthMasSite}" />

                            <CheckBox Content="Recipe"
              Margin="0.8"
              IsChecked="{Binding AuthMasRecp}" />

                            <CheckBox Content="Truck"
              Margin="0.8"
              IsChecked="{Binding AuthMasTrk}" />

                            <CheckBox Content="Order"
              Margin="0.8"
              IsChecked="{Binding AuthMasOrd}" />

                            <CheckBox Content="Schedule"
              Margin="0.8"
              IsChecked="{Binding AuthMasSch}" />

                            <CheckBox Content="Inward"
              Margin="0.8"
              IsChecked="{Binding AuthMasInw}" />

                            <CheckBox Content="Alarm"
              Margin="0.8"
              IsChecked="{Binding AuthMasAlm}" />

                            <CheckBox Content="Maintenance"
              Margin="0.8"
              IsChecked="{Binding AuthMasMnt}" />

                            <Separator Margin="8"/>

                            <CheckBox Content="Credit limit"
              Margin="0.8"/>

                            <CheckBox Content="Import &amp; export"
              Margin="0.8"/>

                            <CheckBox Content="Restore deleted records"
              Margin="0.8"/>

                            <CheckBox Content="Recover batch data"
              Margin="0.8"/>
                        </StackPanel>
                    </Border>

                    <!-- TRANSACTION -->
                    <Border Grid.Column="1"
        Margin="6,0,0,0"
        Padding="18"
        Style="{DynamicResource SiteOuterBorderStyle}">

                        <StackPanel>
                            <TextBlock Text="Transaction / Options"
                                       Margin="0,0,0,8"
                                   Style="{DynamicResource SiteHeaderStyle}"/>

                            <CheckBox Content="Start batch"  Margin="0.8"/>
                            <CheckBox Content="Print batch data"  Margin="0.8"/>
                            <CheckBox Content="Print docket"  Margin="0.8"/>
                            <CheckBox Content="Alarm history view"  Margin="0.8"/>
                            <CheckBox Content="Divert concrete"  Margin="0.8"/>
                            <CheckBox Content="Report view"  Margin="0.8"/>

                            <Separator Margin="5"/>

                            <CheckBox Content="Reconciliation adjustment"  Margin="0.8"/>
                            <CheckBox Content="Cement silo level"  Margin="0.8"/>
                            <CheckBox Content="Generic interface"  Margin="0.8"/>
                            <CheckBox Content="SMS facilities"  Margin="0.8"/>
                            <CheckBox Content="Database handling"  Margin="0.8"/>
                            <CheckBox Content="Analog config"  Margin="0.8"/>
                            <CheckBox Content="Weighbridge config"  Margin="0.8"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ================= RIGHT SIDE ================= -->
            <Border Grid.Column="1"
        Margin="12,0,0,0"
        Padding="18"
        Style="{DynamicResource SiteOuterBorderStyle}">

                <StackPanel>
                    <TextBlock Text="Plant Settings Segment"
                               Margin="0,0,0,16"
               Style="{DynamicResource SiteHeaderStyle}"/>

                    <StackPanel>

                        <CheckBox Content="Gate sequence"
                  Margin="2"
                  IsChecked="{Binding AuthBsGs}" />

                        <CheckBox Content="Jog time"
                  Margin="2"
                  IsChecked="{Binding AuthBsJt}" />

                        <CheckBox Content="Empty valve"
                  Margin="2"
                  IsChecked="{Binding AuthBsEmpv}" />

                        <CheckBox Content="Tolerance"
                  Margin="2"
                  IsChecked="{Binding AuthBsTol}" />

                        <CheckBox Content="Discharge sequence"
                  Margin="2"
                  IsChecked="{Binding AuthBsDsq}" />

                        <CheckBox Content="Step time"
                  Margin="2"
                  IsChecked="{Binding AuthBsStp}" />

                        <CheckBox Content="Batch mode"
                  Margin="2"
                  IsChecked="{Binding AuthBsBom}" />

                        <CheckBox Content="Material in air"
                  Margin="2"
                  IsChecked="{Binding AuthBsMia}" />

                        <CheckBox Content="Coarse to fine"
                  Margin="2"
                  IsChecked="{Binding AuthBsCtf}" />

                        <CheckBox Content="Calibration"
                  Margin="2"/>

                        <CheckBox Content="Bin setup"
                  Margin="2"
                  IsChecked="{Binding AuthOsBin}" />

                        <CheckBox Content="Mixer Grease Pump"
                  Margin="2"
                  IsChecked="{Binding AuthSpMgp}" />

                        <CheckBox Content="Mixer parameter"
                  Margin="2"
                  IsChecked="{Binding AuthSpMxp}" />

                        <CheckBox Content="Skip parameter"
                  Margin="2"
                  IsChecked="{Binding AuthSpSkp}" />

                        <CheckBox Content="Conveyor parameter"
                  Margin="2"
                  IsChecked="{Binding AuthSpCvp}" />

                        <CheckBox Content="Moisture parameter"
                  Margin="2"
                  IsChecked="{Binding AuthSpMtp}" />

                        <CheckBox Content="Vibrator parameter"
                  Margin="2"
                  IsChecked="{Binding AuthSpVbp}" />

                        <CheckBox Content="Capacity"
                  Margin="2"
                  IsChecked="{Binding AuthOsCap}" />

                        <CheckBox Content="Enable / disable / other setup"
                  Margin="2"
                  IsChecked="{Binding AuthOsEdom}" />

                        <CheckBox Content="Batch / discharge time"
                  Margin="2"/>

                        <CheckBox Content="In air / inflow mode"
                  Margin="2"
                  IsChecked="{Binding AuthOsIaif}" />

                        <CheckBox Content="Plant profile"
                  Margin="2"
                  IsChecked="{Binding AuthOsPps}" />

                        <CheckBox Content="Plant profile"
                  Margin="2"/>

                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
        Margin="-12,2,-12,-12"
        Background="#F8F9FB"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="0,0,18,18">

            <Grid Margin="16,14">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- ================= REGISTER ================= -->

                <Button Grid.Column="1"
                Height="46"
                Command="{Binding RegisterCommand}"
                Style="{StaticResource SaveButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Image Source="/Icons/save.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                        <TextBlock Text="Register"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                    </StackPanel>

                </Button>

                <!-- ================= EXIT ================= -->

                <Button Grid.Column="3"
                Height="46"
                Command="{Binding ExitCommand}"
                Style="{StaticResource WhiteActionButtonStyle}">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Image Source="/Icons/exit.png"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"/>

                        <TextBlock Text="Exit"
                           Foreground="#1F2937"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>
    </Grid>
</Window>