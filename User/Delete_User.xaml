<Window x:Class="Scada_Demo.User.Delete_User"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scada_Demo.User"
        mc:Ignorable="d"
                xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Delete_User" Height="370" Width="500"

            Icon="../project_small_i.png"
WindowStartupLocation="CenterScreen">


    <Border Margin="12"
           Style="{DynamicResource SiteOuterBorderStyle}">



        <Border.Effect>

            <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Color="Black"
                                  Opacity="0.12"/>

        </Border.Effect>
        <Grid Margin="16">

            <!-- ================= ROW DEFINITIONS ================= -->

            <Grid.RowDefinitions>

                <RowDefinition Height="85"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="82"/>

            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->

            <Grid Grid.Row="0"
      Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="50"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- HEADER ICON -->

                <Border Width="40"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                    <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform">
                                <VisualBrush.Visual>

                                    <svgc:SvgViewbox Source="/Icons/Bin.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>

                    </Rectangle>


                </Border>


                <!-- HEADER TITLE -->

                <TextBlock Grid.Column="1"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               Text="Delete User"
               Style="{StaticResource SiteHeaderStyle}"/>

                <!-- GREEN LINE -->

                <Grid Grid.ColumnSpan="3"
          VerticalAlignment="Bottom"
          Margin="0,0,0,4">

                    <Border Height="1.5"
                Background="{DynamicResource SiteAccentBrush}"/>

                    <Ellipse Width="10"
                 Height="10"
                 Fill="{DynamicResource SiteAccentBrush}"
                 HorizontalAlignment="Right"
                 Margin="0,-1,0,0"/>

                </Grid>

            </Grid>

            <!-- ================= CONTENT ================= -->

            <Border Grid.Row="1"
            Padding="24"
            Style="{StaticResource SiteOuterBorderStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="150"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="48"/>

                    </Grid.RowDefinitions>

                    <!-- ICON -->

                    <Border Width="40" Grid.Column="0" HorizontalAlignment="Left"
Height="40"

Style="{DynamicResource SiteIconBoxStyle}">
                        <Rectangle Width="24"
  Height="24"
  Fill="{DynamicResource SiteIconBrush}">

                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform">
                                    <VisualBrush.Visual>

                                        <svgc:SvgViewbox Source="/Icons/name.svg"
                        Width="24"
                        Height="24"
                        Stretch="Uniform"/>

                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>

                        </Rectangle>


                    </Border>

                    <!-- LABEL -->

                    <TextBlock Grid.Column="0"
                       Margin="62,0,0,0"
                       VerticalAlignment="Center"
                       Text="User name"
                       Style="{StaticResource SiteLabelStyle}"/>

                    <!-- COMBO -->

                    <ComboBox Grid.Column="2"
                      Width="180"
                      HorizontalAlignment="Left"
                      Style="{StaticResource SiteComboBoxStyles}"/>

                </Grid>

            </Border>

            <!-- ================= FOOTER ================= -->

            <Border Grid.Row="2"
            Margin="-16,12,-16,-16"
            Background="#F8F9FB"
            BorderBrush="#E5E7EB"
            BorderThickness="1,1,1,0"
            CornerRadius="0,0,18,18">

                <Grid Margin="16,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="170"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="170"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- DELETE -->

                    <Button Grid.Column="1"
        Style="{StaticResource WhiteActionButtonStyle}"
        HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                            <Rectangle Width="24"
                   Height="24"
                   Fill="{DynamicResource SiteIconBrush}">

                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>

                                            <svgc:SvgViewbox Source="/Icons/bin.svg"
                                         Width="24"
                                         Height="24"
                                         Stretch="Uniform"/>

                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>

                            </Rectangle>

                            <TextBlock Text="Delete"
                   Margin="8,0,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"/>

                        </StackPanel>

                    </Button>
                    <!-- EXIT -->

                    <Button Grid.Column="3"
                    Style="{StaticResource WhiteActionButtonStyle}">

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <Image Source="/Icons/exit.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0"/>

                            <TextBlock Text="Exit"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </Grid>
    </Border>
</Window>
